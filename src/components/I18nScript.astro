---
// Internationalization script: listens for locale changes and
// swaps text content on elements with data-i18n attributes.
// Supports plain text, innerHTML, placeholder, and aria-label translations.
---

<script>
  import { locale } from '../stores/languageStore';
  import { t } from '../i18n/index';

  // Translate all annotated DOM elements to the given language
  function applyTranslations(lang: 'en' | 'nl') {
    // Text content
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n')!;
      el.textContent = t(key, lang);
    });

    // HTML content (supports rich markup)
    document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
      const key = el.getAttribute('data-i18n-html')!;
      el.innerHTML = t(key, lang);
    });

    // Input/textarea placeholders
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-i18n-placeholder]').forEach((el) => {
      const key = el.getAttribute('data-i18n-placeholder')!;
      el.placeholder = t(key, lang);
    });

    // Accessibility labels
    document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((el) => {
      const key = el.getAttribute('data-i18n-aria')!;
      el.setAttribute('aria-label', t(key, lang));
    });

    // Sync the document language attribute
    document.documentElement.lang = lang;
  }

  // Read persisted language from localStorage, falling back to the store default
  const savedLang = (localStorage.getItem('lang') as 'en' | 'nl') || locale.get();
  if (savedLang === 'en' || savedLang === 'nl') {
    applyTranslations(savedLang);
    // Ensure the nanostore stays in sync with the persisted value
    if (locale.get() !== savedLang) locale.set(savedLang);
  } else {
    applyTranslations(locale.get());
  }

  // Re-apply translations whenever the nanostore locale changes
  locale.listen((lang) => {
    applyTranslations(lang);
  });

  // Fallback listener for cross-bundle compatibility when Vite code-splits
  window.addEventListener('locale-changed', ((e: CustomEvent<'en' | 'nl'>) => {
    applyTranslations(e.detail);
  }) as EventListener);
</script>
