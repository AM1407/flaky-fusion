---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">

    <div class="footer-section contact-info">
      <h3 class="footer-logo">ALESSIO MICCICHÈ</h3>
      <p data-i18n="footer.tagline">Full Stack Engineer & Aspiring DevSecOps</p>
      <div class="contact-details">
        <a href="mailto:hello@alessiomicciche.com">hello@alessiomicciche.com</a>
        <a href="tel:+31600000000">+31 (0) 6 123 456 78</a>
      </div>
    </div>

    <div class="footer-section footer-nav">
      <h4 data-i18n="footer.navTitle">Navigation</h4>
      <ul>
        <li><a href="/" data-i18n="footer.home">Home</a></li>
        <li><a href="/services" data-i18n="footer.services">Services</a></li>
        <li><a href="/projects" data-i18n="footer.projects">Projects</a></li>
        <li><a href="/about" data-i18n="footer.about">About</a></li>
        <li><a href="/contact" data-i18n="footer.contact">Contact</a></li>
        <li><a href="/faq" data-i18n="footer.faq">FAQ</a></li>
      </ul>
    </div>

    <div class="footer-section social-legal">
      <h4 data-i18n="footer.connectTitle">Connect</h4>
      <div class="social-icons">
        <a href="https://github.com/AM1407" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
          <i class="fa-brands fa-github"></i>
        </a>
        <a href="https://linkedin.com/in/alessiomicciche" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn">
          <i class="fa-brands fa-linkedin"></i>
        </a>
        <a href="mailto:hello@alessiomicciche.com" class="social-icon" aria-label="Send Email">
          <i class="fa-solid fa-envelope"></i>
        </a>
        <a href="https://github.com/sponsors/AM1407" target="_blank" rel="noopener noreferrer" class="sponsor-btn" aria-label="Sponsor me on GitHub">
          <i class="fa-solid fa-heart"></i>
          <span data-i18n="footer.sponsor">Sponsor</span>
        </a>
      </div>
      <div class="legal-links">
        <a href="/terms" data-i18n="footer.termsLink">Terms & Conditions</a>
        <a href="/privacy" data-i18n="footer.privacyLink">Privacy Policy</a>
      </div>
      <p class="copyright" data-i18n="footer.copyright">© {currentYear} — Built with Passion & Security</p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background: rgba(11, 13, 16, 1);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 80px 5% 40px;
    margin-top: 100px;
    color: #fff;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 60px;
  }

  .footer-section h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--gordian-blue, #0088cc);
    margin-bottom: 25px;
  }

  .footer-logo {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 10px;
    letter-spacing: -1px;
  }

  /* ── Contact details ── */
  .contact-details a {
    display: block;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    margin-bottom: 12px;
    font-size: 0.95rem;
    transition: color 0.3s ease;
  }

  .contact-details a:hover {
    color: var(--gordian-blue, #0088cc);
  }

  /* ── Nav links with navbar-style underline hover ── */
  .footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-nav a {
    display: inline-block;
    position: relative;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    margin-bottom: 12px;
    font-size: 0.95rem;
    padding-bottom: 2px;
    transition: color 0.3s ease;
  }

  .footer-nav a::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 1.5px;
    bottom: 0;
    left: 0;
    background-color: var(--gordian-blue, #0088cc);
    transform: scaleX(0);
    transform-origin: bottom right;
    transition: transform 0.3s ease-out;
  }

  .footer-nav a:hover {
    color: var(--gordian-blue, #0088cc);
  }

  .footer-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  /* ── Social icons ── */
  .social-icons {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 20px;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.1rem;
    text-decoration: none;
    transition: color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
  }

  .social-icon:hover {
    color: var(--gordian-blue, #0088cc);
    border-color: var(--gordian-blue, #0088cc);
    transform: translateY(-2px);
  }

  /* ── Sponsor button ── */
  .sponsor-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
  }

  .sponsor-btn i {
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .sponsor-btn:hover {
    color: #db61a2;
    border-color: #db61a2;
    transform: translateY(-2px);
  }

  .sponsor-btn:hover i {
    color: #db61a2;
  }

  /* ── Legal links ── */
  .legal-links {
    margin-top: 30px;
    display: flex;
    gap: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 20px;
  }

  .legal-links a {
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    font-size: 0.75rem;
    transition: color 0.3s ease;
  }

  .legal-links a:hover {
    color: var(--gordian-blue, #0088cc);
  }

  .copyright {
    margin-top: 20px;
    font-size: 0.75rem;
    opacity: 0.3;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }
    .social-icons {
      justify-content: center;
    }
    .legal-links {
      justify-content: center;
    }
  }
</style>