---
import LanguageSwitcher from './LanguageSwitcher.tsx';
---

<style>
    .logo {
        width: 60px;
        height: auto;
        margin-left: 150px;
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 20px;
        margin: 0;
        font-size: 20px;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(11, 13, 16, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .nav-right {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-right: 150px;
    }

    .nav-links {
        display: flex;
        gap: 15px;
        color: var(--gordian-text);
    }
    p {
        font-family: var(--font-main);
        text-transform: uppercase;
        letter-spacing: -0.05em;
        color: var(--gordian-text);
    }
    a {
        font-family: var(--font-main);
        text-transform: uppercase;
        letter-spacing: -0.05em;
        color: var(--gordian-text);
        text-decoration: none;
        position: relative;
        padding-bottom: 2px;
    }

    /* Animated underline effect on hover */
    a:not(.logo-link)::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 1.5px;
        bottom: 0;
        left: 0;
        background-color: var(--gordian-blue);
        transform: scaleX(0);
        transform-origin: bottom right;
        transition: transform 0.3s ease-out;
    }

    a:hover {
        color: var(--gordian-blue);
        transition: color 0.3s ease;
    }

    a:not(.logo-link):hover::after {
        transform: scaleX(1);
        transform-origin: bottom left;
    }

    /* Language toggle button styles */
    :global(.lang-switcher) {
        display: flex;
        gap: 4px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        padding: 3px;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    :global(.lang-btn) {
        font-family: var(--font-main);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 5px 12px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        background: transparent;
        color: var(--gordian-text);
        transition: background 0.25s ease, color 0.25s ease;
    }

    :global(.lang-btn:hover) {
        color: #fff;
    }

    :global(.lang-btn.active) {
        background: var(--gordian-blue);
        color: #fff;
        box-shadow: 0 2px 8px rgba(0, 136, 204, 0.35);
    }
</style>

<nav>
    <a href="/" class="logo-link"><img src="img/Gordian400dpi.svg" alt="Logo" class="logo" /></a>
    <div class="nav-right">
      <div class="nav-links">
        <a href="/about" data-i18n="nav.about">About Me</a>
        <a href="/services" data-i18n="nav.services">Services</a>
        <a href="/projects" data-i18n="nav.projects">Projects</a>  
        <a href="/blog" data-i18n="nav.blog">Blog</a>
        <a href="/contact" data-i18n="nav.contact">Contact</a>
      </div>
      <LanguageSwitcher client:load />
    </div>
</nav>