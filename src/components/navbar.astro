<style>
    .logo {
        width: 60px;
        height: auto;
        margin-left: 150px;
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 20px;
        margin: 0;
        font-size: 20px;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        background: rgba(11, 13, 16, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .nav-links {
        display: flex;
        gap: 15px;
        color: var(--gordian-text);
        margin-right: 150px;
    }
    p {
        font-family: var(--font-main);
        text-transform: uppercase;
        letter-spacing: -0.05em;
        color: var(--gordian-text);
    }
    a {
        font-family: var(--font-main);
        text-transform: uppercase;
        letter-spacing: -0.05em;
        color: var(--gordian-text);
        text-decoration: none;
        /* Nodig voor de positionering van de underline */
        position: relative;
        padding-bottom: 2px;
    }

    /* Het underline effect */
    a:not(.logo-link)::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 1.5px; /* Dikte van de underline */
        bottom: 0;
        left: 0;
        background-color: var(--gordian-blue);
        transform: scaleX(0);
        transform-origin: bottom right;
        transition: transform 0.3s ease-out;
    }

    a:hover {
        color: var(--gordian-blue);
        transition: color 0.3s ease;
    }

    a:not(.logo-link):hover::after {
        transform: scaleX(1);
        transform-origin: bottom left;
    }

</style>




<nav>
    <a href="/" class="logo-link"><img src="img/Gordian400dpi.svg" alt="Logo" class="logo" /></a>
    <div class="nav-links">
    <a href="/about">About Me</a>
    <a href="/projects">Projects</a>  
    <a href="/blog">Blog</a>
    <a href="/contact">Contact</a>
    </div>
</nav>