---
// Splash screen overlay with animated logo reveal using GSAP
---
<div id="splash-overlay" class="fixed inset-0 z-[10000] bg-black flex items-center justify-center overflow-hidden">
  <div class="logo-wrapper relative w-[250px] h-[250px] md:w-[350px] md:h-[350px]"> 
    <img 
      src="/img/gordianlogoblue.svg" 
      id="splash-blue" 
      class="absolute w-full h-full object-contain pointer-events-none" 
      alt=""
      width="350"
      height="350"
      fetchpriority="high"
    />
    <img 
      src="/img/gordianlogored.svg" 
      id="splash-red" 
      class="absolute w-full h-full object-contain pointer-events-none" 
      alt=""
      width="350"
      height="350"
      fetchpriority="high"
    />
  </div>
</div>

<style>
  /* Prevent scrolling while splash is visible */
  :global(body.loading) {
    overflow: hidden;
  }

  /* Full-screen overlay background */
  #splash-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #2B2F36;
    background: linear-gradient(0deg,rgba(43, 47, 54, 1) 53%, rgba(11, 13, 16, 1) 100%);
    z-index: 10000;
    /* Center the logo wrapper */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Logo container — controls splash logo dimensions */
  .logo-wrapper {
    position: relative;
    /* Adjust these values to scale the logo */
    width: 250px !important; 
    height: 250px !important;
    padding: 0;
    margin: 0;
  }

  /* Logo images fill the wrapper and preserve aspect ratio */
  #splash-blue, #splash-red {
    position: absolute;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain;
    margin: 0;
  }

  /* Larger logo on desktop viewports */
  @media (min-width: 768px) {
    .logo-wrapper {
      width: 350px !important;
      height: 350px !important;
    }
  }
</style>

<!-- Synchroon inline script: verbergt overlay VOOR render als splash al gezien is -->
<script is:inline>
  if (sessionStorage.getItem('splashSeen')) {
    document.getElementById('splash-overlay').style.display = 'none';
  }
</script>

<script>
  import { gsap } from 'gsap';

  // Module scripts are deferred — DOM is already parsed when this runs
  const hasSeenSplash = sessionStorage.getItem('splashSeen');

  if (hasSeenSplash) {
    // Splash already shown this session — skip animation
    window.dispatchEvent(new Event('splash-finished'));
  } else {
    // First visit: play the logo entrance animation
    document.body.classList.add('loading');

    const tl = gsap.timeline({
      onComplete: () => {
        const overlay = document.getElementById('splash-overlay');
        if (overlay) overlay.style.display = 'none';
        document.body.classList.remove('loading');
        sessionStorage.setItem('splashSeen', 'true');
        window.dispatchEvent(new Event('splash-finished'));
      }
    });

    tl.fromTo("#splash-blue", 
      { x: -400, y: -200, opacity: 0 }, 
      { x: -17, y: -17, opacity: 1, duration: 1.5, ease: "power4.out" }
    )
    .fromTo("#splash-red", 
      { x: 400, y: 200, opacity: 0 }, 
      { x: 17, y: 17, opacity: 1, duration: 1.5, ease: "power4.out" }, 
      "<"
    )
    .to("#splash-overlay", { 
      opacity: 0, 
      duration: 0.8, 
      delay: 0.8 
    });
  }
</script>