---
// Terminal boot splash
---

<div id="splash-overlay">
  <div class="terminal-boot">
    <div class="boot-header">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
      <span class="boot-title">boot.sh — root@portfolio:~</span>
    </div>
    <div class="boot-body">
      <div class="boot-line" id="bl-0">
        <span class="prompt">root@portfolio:~$</span>
        <span class="cmd"> ./init.sh --mode=secure</span>
      </div>
      <div class="boot-line anim-1" id="bl-1">&gt; Initializing system kernel...</div>
      <div class="boot-line anim-2" id="bl-2">
        &gt; Loading security modules&nbsp;&nbsp;&nbsp;<span class="progress-bar">████████████████</span><span class="ok anim-ok">[OK]</span>
      </div>
      <div class="boot-line anim-3" id="bl-3">&gt; Verifying TLS certificates&nbsp;&nbsp;&nbsp;&nbsp;<span class="ok">[VERIFIED]</span></div>
      <div class="boot-line anim-4" id="bl-4">&gt; Establishing secure channel&nbsp;&nbsp;&nbsp;<span class="ok">[ENCRYPTED]</span></div>
      <div class="boot-line anim-5 accent" id="bl-5">&gt; ACCESS GRANTED<span class="cursor-boot"></span></div>
    </div>
  </div>
</div>

<style>
  :global(body.loading) {
    overflow: hidden;
  }

  #splash-overlay {
    position: fixed;
    inset: 0;
    background: var(--bg-primary);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: splashFadeOut 0.5s 2.2s ease-in both;
  }

  @keyframes splashFadeOut {
    to { opacity: 0; }
  }

  .terminal-boot {
    width: min(520px, 88vw);
    background: var(--bg-surface);
    border: 1px solid rgba(0, 212, 255, 0.22);
    border-radius: 8px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(0, 212, 255, 0.04),
      0 24px 60px rgba(0, 0, 0, 0.7);
  }

  .boot-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--bg-surface-2);
    border-bottom: 1px solid var(--border-dim);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot-red    { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green  { background: #28c840; }

  .boot-title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .boot-body {
    padding: 22px 22px 26px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-height: 180px;
  }

  .boot-line {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-secondary);
    white-space: nowrap;
    opacity: 0;
    animation: lineAppear 0.001s both;
  }

  /* bl-0 visible immediately */
  #bl-0 { opacity: 1; animation: none; }

  .anim-1 { animation-delay: 0.15s; }
  .anim-2 { animation-delay: 0.4s; }
  .anim-3 { animation-delay: 1.1s; }
  .anim-4 { animation-delay: 1.25s; }
  .anim-5 { animation-delay: 1.5s; }

  @keyframes lineAppear {
    to { opacity: 1; }
  }

  .boot-line .prompt { color: var(--cyber-cyan); font-weight: 700; }
  .boot-line .cmd    { color: var(--text-primary); }

  .boot-line.accent {
    color: var(--cyber-cyan);
    font-weight: 700;
    font-size: 0.88rem;
    margin-top: 6px;
    letter-spacing: 0.04em;
  }

  .ok {
    color: var(--cyber-cyan);
    font-weight: 600;
  }

  /* Progress bar grows char-by-char via steps */
  .progress-bar {
    display: inline-block;
    overflow: hidden;
    max-width: 0;
    white-space: nowrap;
    color: var(--cyber-cyan);
    font-size: 0.75rem;
    letter-spacing: -1px;
    vertical-align: bottom;
    animation: growBar 0.56s 0.4s steps(16, end) both;
  }

  @keyframes growBar {
    to { max-width: 16ch; }
  }

  /* [OK] appears after progress bar finishes */
  .ok.anim-ok {
    opacity: 0;
    animation: lineAppear 0.001s 0.96s both;
  }

  .cursor-boot {
    display: inline-block;
    width: 8px;
    height: 0.95em;
    background: var(--cyber-cyan);
    margin-left: 4px;
    vertical-align: text-bottom;
    animation: cursor-blink 1s step-end infinite;
  }
</style>

<!-- Hide immediately if already seen this session -->
<script is:inline>
  (function () {
    if (sessionStorage.getItem('splashSeen')) {
      var el = document.getElementById('splash-overlay');
      if (el) { el.style.display = 'none'; el.style.animation = 'none'; }
    }
  })();
</script>

<script>
  const hasSeenSplash = sessionStorage.getItem('splashSeen');

  if (hasSeenSplash) {
    window.dispatchEvent(new Event('splash-finished'));
  } else {
    document.body.classList.add('loading');
    const overlay = document.getElementById('splash-overlay')!;

    overlay.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName === 'splashFadeOut' && e.target === overlay) {
        overlay.style.display = 'none';
        document.body.classList.remove('loading');
        sessionStorage.setItem('splashSeen', 'true');
        window.dispatchEvent(new Event('splash-finished'));
      }
    });
  }
</script>
