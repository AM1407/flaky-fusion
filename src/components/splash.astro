---
// Terminal boot splash — replaces logo animation
---

<div id="splash-overlay">
  <div class="terminal-boot">
    <div class="boot-header">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
      <span class="boot-title">boot.sh — root@portfolio:~</span>
    </div>
    <div class="boot-body">
      <div class="boot-line" id="bl-0">
        <span class="prompt">root@portfolio:~$</span>
        <span class="cmd"> ./init.sh --mode=secure</span>
      </div>
      <div class="boot-line hidden" id="bl-1">&gt; Initializing system kernel...</div>
      <div class="boot-line hidden" id="bl-2">
        &gt; Loading security modules&nbsp;&nbsp;&nbsp;
        <span class="progress-bar" id="progress-bar"></span>
        <span class="ok hidden" id="ok-modules">[OK]</span>
      </div>
      <div class="boot-line hidden" id="bl-3">&gt; Verifying TLS certificates&nbsp;&nbsp;&nbsp;&nbsp;<span class="ok">[VERIFIED]</span></div>
      <div class="boot-line hidden" id="bl-4">&gt; Establishing secure channel&nbsp;&nbsp;&nbsp;<span class="ok">[ENCRYPTED]</span></div>
      <div class="boot-line hidden accent" id="bl-5">&gt; ACCESS GRANTED<span class="cursor-boot"></span></div>
    </div>
  </div>
</div>

<style>
  :global(body.loading) {
    overflow: hidden;
  }

  #splash-overlay {
    position: fixed;
    inset: 0;
    background: #050a0e;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .terminal-boot {
    width: min(520px, 88vw);
    background: #0a1520;
    border: 1px solid rgba(0, 255, 65, 0.22);
    border-radius: 8px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(0, 255, 65, 0.04),
      0 24px 60px rgba(0, 0, 0, 0.7);
  }

  .boot-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: #0d1f2d;
    border-bottom: 1px solid rgba(232, 244, 248, 0.06);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot-red    { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green  { background: #28c840; }

  .boot-title {
    margin-left: 8px;
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.72rem;
    color: #7a9bb5;
    letter-spacing: 0.02em;
  }

  .boot-body {
    padding: 22px 22px 26px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-height: 180px;
  }

  .boot-line {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.82rem;
    color: #7a9bb5;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .boot-line.hidden { opacity: 0; }

  .boot-line .prompt { color: #00ff41; font-weight: 700; }
  .boot-line .cmd    { color: #e8f4f8; }

  .boot-line.accent {
    color: #00ff41;
    font-weight: 700;
    font-size: 0.88rem;
    margin-top: 6px;
    letter-spacing: 0.04em;
  }

  .ok {
    color: #00ff41;
    font-weight: 600;
  }

  .ok.hidden { opacity: 0; }

  .progress-bar {
    color: #00ff41;
    font-size: 0.75rem;
    letter-spacing: -1px;
  }

  .cursor-boot {
    display: inline-block;
    width: 8px;
    height: 0.95em;
    background: #00ff41;
    margin-left: 4px;
    vertical-align: text-bottom;
    animation: cursor-blink 1s step-end infinite;
  }
</style>

<!-- Hide immediately if already seen this session -->
<script is:inline>
  (function () {
    if (sessionStorage.getItem('splashSeen')) {
      var el = document.getElementById('splash-overlay');
      if (el) el.style.display = 'none';
    }
  })();
</script>

<script>
  import { gsap } from 'gsap';

  const hasSeenSplash = sessionStorage.getItem('splashSeen');

  if (hasSeenSplash) {
    window.dispatchEvent(new Event('splash-finished'));
  } else {
    document.body.classList.add('loading');

    const PROGRESS_FULL = '████████████████';
    const progressEl = document.getElementById('progress-bar')!;
    const okModules  = document.getElementById('ok-modules')!;

    function animateProgress(onDone: () => void) {
      let i = 0;
      const interval = setInterval(() => {
        progressEl.textContent = PROGRESS_FULL.slice(0, i + 1);
        i++;
        if (i >= PROGRESS_FULL.length) {
          clearInterval(interval);
          onDone();
        }
      }, 55);
    }

    const finish = () => {
      gsap.to('#splash-overlay', {
        opacity: 0,
        duration: 0.5,
        delay: 0.4,
        ease: 'power1.in',
        onComplete: () => {
          const overlay = document.getElementById('splash-overlay');
          if (overlay) overlay.style.display = 'none';
          document.body.classList.remove('loading');
          sessionStorage.setItem('splashSeen', 'true');
          window.dispatchEvent(new Event('splash-finished'));
        }
      });
    };

    const tl = gsap.timeline({ onComplete: finish });

    tl
      .to('#bl-1', { opacity: 1, duration: 0 }, 0.25)
      .to('#bl-2', {
        opacity: 1, duration: 0,
        onComplete: () => animateProgress(() => {
          okModules.classList.remove('hidden');
          gsap.to(okModules, { opacity: 1, duration: 0.1 });
        })
      }, 0.6)
      .to('#bl-3', { opacity: 1, duration: 0 }, 1.8)
      .to('#bl-4', { opacity: 1, duration: 0 }, 2.3)
      .to('#bl-5', { opacity: 1, duration: 0 }, 2.8);
  }
</script>
