---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';

const techStack = [
  { name: "HTML5", icon:"fa-brands fa-html5" },
  { name: "CSS", icon:"fa-brands fa-css3-alt" },
  { name: "Bootstrap", icon:"fa-brands fa-bootstrap" },
  { name: "Tailwind", icon:"custom-svg", svgPath: "M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z" },
  { name: "Typescript", icon:"custom-svg", svgPath: "M1.125 0C.502 0 0 .502 0 1.125v21.75C0 23.498.502 24 1.125 24h21.75c.623 0 1.125-.502 1.125-1.125V1.125C24 .502 23.498 0 22.875 0H1.125zm17.363 9.75c.612 0 1.154.037 1.627.111a6.38 6.38 0 0 1 1.306.34v2.458a3.95 3.95 0 0 0-.643-.361 5.093 5.093 0 0 0-.717-.26 5.453 5.453 0 0 0-1.426-.2c-.3 0-.573.028-.819.086a2.1 2.1 0 0 0-.623.242c-.17.104-.3.229-.393.374a.888.888 0 0 0-.14.49c0 .196.053.373.156.529.106.156.252.304.437.444s.423.276.714.41c.29.135.634.285 1.033.451 1.258.528 2.179 1.1 2.763 1.72s.874 1.403.874 2.345c0 .596-.109 1.14-.325 1.63a3.504 3.504 0 0 1-.905 1.328 4.21 4.21 0 0 1-1.404.912c-.546.216-1.146.322-1.802.322-.647 0-1.242-.061-1.786-.182a7.61 7.61 0 0 1-1.554-.516v-2.702c.433.297.913.541 1.441.731.528.19 1.077.284 1.646.284.887 0 1.517-.202 1.89-.608.238-.258.358-.596.358-1.014 0-.252-.05-.472-.15-.66a1.19 1.19 0 0 0-.414-.46c-.175-.119-.408-.235-.698-.35s-.644-.258-1.062-.435c-.742-.313-1.344-.644-1.806-.993a3.511 3.511 0 0 1-1.117-1.31 3.56 3.56 0 0 1-.397-1.698c0-.946.337-1.735 1.011-2.368.675-.632 1.573-.949 2.695-.949zm-15.451.127h8.216v2.332H8.539v10.316H5.775V12.209H3.037V9.877z"},
  { name: "Javascript", icon:"fa-brands fa-js" },
  { name: "Angular", icon:"fa-brands fa-angular" },
  { name: "Vite", icon:"custom-svg", svgPath: "M18.598 2.81a.675.675 0 0 0-1.215.002L3.996 22.507a.675.675 0 0 0 .777.937l5.313-1.332a.675.675 0 0 1 .792.906l-1.335 3.012a.675.675 0 0 0 1.144.733L21.94 9.15a.675.675 0 0 0-.547-1.116l-5.326.01a.675.675 0 0 1-.62-.916l3.15-4.309z" },
  { name: "Astro", icon:"custom-svg", svgPath:"M0 19.5103C0 19.5103 3.99947 17.5552 8.01012 17.5552L11.034 8.16461C11.1472 7.71047 11.4778 7.40185 11.8509 7.40185C12.2241 7.40185 12.5547 7.71047 12.6679 8.16461L15.6918 17.5552C20.4418 17.5552 23.7019 19.5103 23.7019 19.5103C23.7019 19.5103 16.9085 0.939907 16.8952 0.902648C16.7002 0.353607 16.3711 0 15.9273 0H7.77531C7.33154 0 7.01567 0.353607 6.80741 0.902648C6.79274 0.939204 0 19.5103 0 19.5103Z M7.70883 25.5523C6.35819 24.3134 5.9639 21.7103 6.52661 19.8245C7.50233 21.0135 8.85426 21.3901 10.2546 21.6027C12.4164 21.9308 14.5395 21.8081 16.5477 20.8166C16.7774 20.7031 16.9897 20.5522 17.2407 20.3993C17.4292 20.9478 17.4782 21.5017 17.4124 22.0653C17.2524 23.4381 16.5716 24.4985 15.4887 25.3023C15.0557 25.6238 14.5975 25.9112 14.1503 26.2144C12.7765 27.1462 12.4048 28.2387 12.921 29.828C12.9333 29.8667 12.9443 29.9054 12.972 29.9999C12.2705 29.6849 11.7582 29.2263 11.3678 28.6232C10.9554 27.9867 10.7592 27.2826 10.7489 26.5208C10.7437 26.1501 10.7437 25.776 10.694 25.4106C10.5727 24.5195 10.1559 24.1205 9.37051 24.0975C8.56451 24.0739 7.92694 24.5739 7.75787 25.3613C7.74497 25.4217 7.72625 25.4814 7.70754 25.5516L7.70883 25.5523Z"},
  { name: "Laravel", icon:"fa-brands fa-laravel" },
  { name: "PHP", icon:"fa-brands fa-php" },
  { name: "Linux", icon: "fa-brands fa-linux" },
  { name: "Git", icon: "fa-brands fa-git-alt" },
  { name: "nodeJS", icon:"fa-brands fa-node-js" },
  { name: "mySQL", icon: "fa-solid fa-database" },
  { name: "Python", icon:"fa-brands fa-python" },
  { name: "NPM", icon:"fa-brands fa-npm" },
  { name: "CI/CD", icon: "fa-solid fa-arrows-spin" },
];

const whyMeCards = [
  {
    icon: "fa-solid fa-shield-halved",
    title: "Security-First Approach",
    text: "Every line of code is written with security in mind. From secure architecture design to automated vulnerability scanning, I embed protection into the development lifecycle — not as an afterthought, but as a foundation."
  },
  {
    icon: "fa-solid fa-bolt",
    title: "Fast & Reliable Delivery",
    text: "I combine agile workflows with CI/CD pipelines to deliver production-ready features quickly. You get clean, tested code on schedule — without sacrificing quality or cutting corners."
  },
  {
    icon: "fa-solid fa-layer-group",
    title: "Full Stack Expertise",
    text: "From responsive front-ends to robust back-end APIs and cloud infrastructure, I handle the entire stack. One point of contact, one cohesive vision — no gaps between design and deployment."
  },
  {
    icon: "fa-solid fa-handshake",
    title: "Clear Communication",
    text: "No jargon, no disappearing acts. I keep you in the loop with transparent updates, honest timelines, and straightforward explanations — so you always know where your project stands."
  },
];
---

<Layout title="About Me" description="Learn about Alessio Miccichè — a full stack developer and DevSecOps consultant based in Belgium, specialising in secure and scalable web solutions.">
  <Navbar />
  <main class="container">
    <!-- Bio and profile picture -->
    <section class="about-section">
      <h1 class="section-title" data-i18n="about.title">About Me</h1>
      <div class="aboutcontent">
        <div class="about-text">
          <p data-i18n="about.paragraphs.0">Hi, I'm Alessio, a full stack developer and DevSecOps consultant based in Belgium. With experience across the tech industry, I specialise in building secure, scalable web applications and infrastructure for clients across Europe and beyond.</p>
          <p data-i18n="about.paragraphs.1">My journey in tech started with a passion for coding and problem-solving, which led me to explore various programming languages and frameworks. Over the years, I've honed my skills in both front-end and back-end development, as well as cloud architecture and security best practices.</p>
          <p data-i18n="about.paragraphs.2">When I'm not coding, you can find me exploring the latest trends in technology, contributing to open source projects, or enjoying the great outdoors. I'm always eager to take on new challenges and collaborate with like-minded individuals to create impactful solutions.</p>
        </div>
        <div class="profile-pic-wrapper">
          <img src="/img/Gordian400dpi.svg" data-i18n-aria="about.profileAlt" alt="Profile Picture" class="profile-pic" />
        </div>
      </div>
    </section>

    <!-- Technologies and tools -->
    <section class="stack-section">
      <h2 class="section-title" data-i18n="about.stackTitle">Tech Stack</h2>
      <p class="section-subtitle" data-i18n="about.stackSubtitle">The tools and technologies I use to bring ideas to life.</p>
      <div class="stack-grid">
        {techStack.map((tech) => (
          <div class="stack-block">
            {tech.icon === "custom-svg" ? (
              /* Handmatige Tailwind SVG omdat de CDN versie 7.2.0 niet ondersteunt */
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d={tech.svgPath} />
              </svg>
            ) : (
              /* Standaard FontAwesome iconen */
              <i class={tech.icon}></i>
            )}
            <span>{tech.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Differentiators -->
    <section class="why-section">
      <h2 class="section-title" data-i18n="about.whyTitle">Why Me?</h2>
      <p class="section-subtitle" data-i18n="about.whySubtitle">Here's what sets me apart from the rest.</p>
      <div class="why-grid">
        {whyMeCards.map((card, i) => (
          <div class="why-card">
            <div class="why-card-icon">
              <i class={card.icon}></i>
            </div>
            <h3 data-i18n={`about.whyCards.${i}.title`}>{card.title}</h3>
            <p data-i18n={`about.whyCards.${i}.text`}>{card.text}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Page layout */
  .container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px 60px;
  }

  .section-title {
    font-family: var(--font-main);
    font-variation-settings: "wght" 800, "wdth" 110;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    color: var(--gordian-text);
    font-size: 1.05rem;
    margin-bottom: 24px;
    line-height: 1.6;
  }

  /* Bio section */
  .about-section {
    padding-top: 16px;
    margin-bottom: 48px;
  }

  .aboutcontent {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 40px;
    margin-top: 24px;
  }

  .about-text {
    flex: 1;
  }

  .about-text p {
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.8;
    margin-bottom: 16px;
    font-size: 1rem;
  }

  /* Profile image with 3D border ring */
  .profile-pic-wrapper {
    flex-shrink: 0;
    position: relative;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    /* 3D layered ring */
    background: conic-gradient(
      from 0deg,
      var(--gordian-blue),
      #1a3a5c,
      var(--gordian-blue),
      #0d2f50,
      var(--gordian-blue)
    );
    padding: 4px;
    box-shadow:
      0 4px 15px rgba(0, 136, 204, 0.35),
      0 8px 30px rgba(0, 136, 204, 0.15),
      inset 0 2px 4px rgba(255, 255, 255, 0.15),
      0 12px 40px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .profile-pic-wrapper::before {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid rgba(0, 136, 204, 0.15);
    pointer-events: none;
  }

  .profile-pic-wrapper:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow:
      0 6px 20px rgba(0, 136, 204, 0.5),
      0 12px 40px rgba(0, 136, 204, 0.25),
      inset 0 2px 4px rgba(255, 255, 255, 0.2),
      0 16px 50px rgba(0, 0, 0, 0.6);
  }

  .profile-pic {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: #2B2F36;
    display: block;
  }

  /* Technology stack grid blocks */
  .stack-section {
    margin-bottom: 48px;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 16px;
  }

  .stack-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px 12px;
    border-radius: 12px;
    cursor: default;
    /* 3D surface */
    background: linear-gradient(145deg, #33373f, #282c33);
    border: 1px solid rgba(255, 255, 255, 0.06);
    /* 3D depth */
    box-shadow:
      6px 6px 14px rgba(0, 0, 0, 0.45),
      -3px -3px 10px rgba(255, 255, 255, 0.03),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transition:
      transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .stack-block:hover, {
    transform: translateY(-6px) scale(1.04);
    border-color: rgba(0, 136, 204, 0.4);
    box-shadow:
      0 12px 28px rgba(0, 136, 204, 0.2),
      0 4px 12px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .stack-block i {
    font-size: 1.8rem;
    color: var(--gordian-blue);
    transition: color 0.3s ease, transform 0.3s ease;
    filter: drop-shadow(0 2px 6px rgba(0, 136, 204, 0.3));
  }

  .stack-block:hover i{
    color: #33aaee;
    transform: scale(1.15);
  }

  .stack-block span {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .stack-block:hover span {
    color: #fff;
  }

  /* 1. Zorg dat de SVG standaard de cyber-blue kleur en gloed heeft */
.stack-block svg {
  width: 1.50rem !important;
  height: 1.50rem !important;
  color: var(--gordian-blue);
  fill: var(--gordian-blue);
  filter: drop-shadow(0 0 2px var(--gordian-blue));
  transition: all 0.3s ease; /* Zorg voor een vloeiende overgang */
}

/* 2. De Hover State: Wanneer je over het VAKJE (stack-block) gaat */
.stack-block:hover i,
.stack-block:hover svg {
  color: #fff !important; /* Of een andere kleur die je voor je hover gebruikt */
  fill: #fff !important;
  filter: drop-shadow(0 0 12px var(--gordian-blue)); /* Versterk de gloed bij hover */
  transform: translateY(-2px); /* Optioneel: een kleine subtiele lift */
}

/* 3. Specifieke overrule voor de path kleur */
.stack-block svg path {
  fill: currentColor;
}

  /* Differentiator cards */
  .why-section {
    margin-bottom: 20px;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .why-card {
    padding: 28px 24px;
    border-radius: 14px;
    background: linear-gradient(145deg, #33373f, #282c33);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow:
      6px 6px 14px rgba(0, 0, 0, 0.4),
      -3px -3px 10px rgba(255, 255, 255, 0.02),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition:
      transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .why-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 136, 204, 0.3);
    box-shadow:
      0 14px 32px rgba(0, 136, 204, 0.15),
      0 6px 14px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .why-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    background: rgba(0, 136, 204, 0.1);
    border: 1px solid rgba(0, 136, 204, 0.2);
    box-shadow: 0 2px 8px rgba(0, 136, 204, 0.15);
  }

  .why-card-icon i {
    font-size: 1.2rem;
    color: var(--gordian-blue);
  }

  .why-card h3 {
    color: #fff;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .why-card p {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Mobile layout adjustments */
  @media (max-width: 700px) {
    .aboutcontent {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .profile-pic-wrapper {
      order: -1;
      width: 150px;
      height: 150px;
    }

    .why-grid {
      grid-template-columns: 1fr;
    }

    .stack-grid {
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
      gap: 12px;
    }

    .stack-block {
      padding: 18px 10px;
    }

    .stack-block i {
      font-size: 1.5rem;
    }
  }
</style>