---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';

const techStack = [
  { name: "HTML5", icon:"fa-brands fa-html5" },
  { name: "CSS", icon:"fa-brands fa-css3-alt" },
  { name: "Bootstrap", icon:"fa-brands fa-bootstrap" },
  { name: "Tailwind", icon:"custom-svg", svgPath: "M12.001 4.8c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624C13.666 10.618 15.027 12 18.001 12c3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C16.337 6.182 14.976 4.8 12.001 4.8zm-6 7.2c-3.2 0-5.2 1.6-6 4.8 1.2-1.6 2.6-2.2 4.2-1.8.913.228 1.565.89 2.288 1.624 1.177 1.194 2.538 2.576 5.512 2.576 3.2 0 5.2-1.6 6-4.8-1.2 1.6-2.6 2.2-4.2 1.8-.913-.228-1.565-.89-2.288-1.624C10.337 13.382 8.976 12 6.001 12z" },
  { name: "Typescript", icon:"custom-svg", svgPath: "M1.125 0C.502 0 0 .502 0 1.125v21.75C0 23.498.502 24 1.125 24h21.75c.623 0 1.125-.502 1.125-1.125V1.125C24 .502 23.498 0 22.875 0H1.125zm17.363 9.75c.612 0 1.154.037 1.627.111a6.38 6.38 0 0 1 1.306.34v2.458a3.95 3.95 0 0 0-.643-.361 5.093 5.093 0 0 0-.717-.26 5.453 5.453 0 0 0-1.426-.2c-.3 0-.573.028-.819.086a2.1 2.1 0 0 0-.623.242c-.17.104-.3.229-.393.374a.888.888 0 0 0-.14.49c0 .196.053.373.156.529.106.156.252.304.437.444s.423.276.714.41c.29.135.634.285 1.033.451 1.258.528 2.179 1.1 2.763 1.72s.874 1.403.874 2.345c0 .596-.109 1.14-.325 1.63a3.504 3.504 0 0 1-.905 1.328 4.21 4.21 0 0 1-1.404.912c-.546.216-1.146.322-1.802.322-.647 0-1.242-.061-1.786-.182a7.61 7.61 0 0 1-1.554-.516v-2.702c.433.297.913.541 1.441.731.528.19 1.077.284 1.646.284.887 0 1.517-.202 1.89-.608.238-.258.358-.596.358-1.014 0-.252-.05-.472-.15-.66a1.19 1.19 0 0 0-.414-.46c-.175-.119-.408-.235-.698-.35s-.644-.258-1.062-.435c-.742-.313-1.344-.644-1.806-.993a3.511 3.511 0 0 1-1.117-1.31 3.56 3.56 0 0 1-.397-1.698c0-.946.337-1.735 1.011-2.368.675-.632 1.573-.949 2.695-.949zm-15.451.127h8.216v2.332H8.539v10.316H5.775V12.209H3.037V9.877z"},
  { name: "Javascript", icon:"fa-brands fa-js" },
  { name: "Angular", icon:"fa-brands fa-angular" },
  { name: "Vite", icon:"custom-svg", svgPath: "M18.598 2.81a.675.675 0 0 0-1.215.002L3.996 22.507a.675.675 0 0 0 .777.937l5.313-1.332a.675.675 0 0 1 .792.906l-1.335 3.012a.675.675 0 0 0 1.144.733L21.94 9.15a.675.675 0 0 0-.547-1.116l-5.326.01a.675.675 0 0 1-.62-.916l3.15-4.309z" },
  { name: "Astro", icon:"custom-svg", svgPath:"M0 19.5103C0 19.5103 3.99947 17.5552 8.01012 17.5552L11.034 8.16461C11.1472 7.71047 11.4778 7.40185 11.8509 7.40185C12.2241 7.40185 12.5547 7.71047 12.6679 8.16461L15.6918 17.5552C20.4418 17.5552 23.7019 19.5103 23.7019 19.5103C23.7019 19.5103 16.9085 0.939907 16.8952 0.902648C16.7002 0.353607 16.3711 0 15.9273 0H7.77531C7.33154 0 7.01567 0.353607 6.80741 0.902648C6.79274 0.939204 0 19.5103 0 19.5103Z M7.70883 25.5523C6.35819 24.3134 5.9639 21.7103 6.52661 19.8245C7.50233 21.0135 8.85426 21.3901 10.2546 21.6027C12.4164 21.9308 14.5395 21.8081 16.5477 20.8166C16.7774 20.7031 16.9897 20.5522 17.2407 20.3993C17.4292 20.9478 17.4782 21.5017 17.4124 22.0653C17.2524 23.4381 16.5716 24.4985 15.4887 25.3023C15.0557 25.6238 14.5975 25.9112 14.1503 26.2144C12.7765 27.1462 12.4048 28.2387 12.921 29.828C12.9333 29.8667 12.9443 29.9054 12.972 29.9999C12.2705 29.6849 11.7582 29.2263 11.3678 28.6232C10.9554 27.9867 10.7592 27.2826 10.7489 26.5208C10.7437 26.1501 10.7437 25.776 10.694 25.4106C10.5727 24.5195 10.1559 24.1205 9.37051 24.0975C8.56451 24.0739 7.92694 24.5739 7.75787 25.3613C7.74497 25.4217 7.72625 25.4814 7.70754 25.5516L7.70883 25.5523Z"},
  { name: "Laravel", icon:"fa-brands fa-laravel" },
  { name: "PHP", icon:"fa-brands fa-php" },
  { name: "Alpine.js", icon: "custom-svg", svgPath: "m24 12-5.72 5.746-5.724-5.741 5.724-5.75L24 12zM5.72 6.254 0 12l5.72 5.746h11.44L5.72 6.254z" },  
  { name: "Livewire", icon: "custom-svg", svgPath: "M12.001 0C6.1735 0 1.4482 4.9569 1.4482 11.0723c0 2.0888.5518 4.0417 1.5098 5.709.2492.2796.544.4843.9649.4843 1.3388 0 1.2678-2.0644 2.6074-2.0644 1.3395 0 1.4111 2.0644 2.75 2.0644 1.3388 0 1.2659-2.0644 2.6054-2.0644.5845 0 .9278.3967 1.2403.8398-.2213-.2055-.4794-.3476-.8203-.3476-1.1956 0-1.3063 1.6771-2.2012 2.1406v4.5097c0 .9145.7418 1.6563 1.6562 1.6563.9145 0 1.6563-.7418 1.6563-1.6563v-5.8925c.308.4332.647.8144 1.2207.8144 1.3388 0 1.266-2.0644 2.6055-2.0644.465 0 .7734.2552 1.039.58-.1294-.0533-.2695-.0878-.4297-.0878-1.1582 0-1.296 1.574-2.1171 2.0937v2.4356c0 .823.6672 1.4902 1.4902 1.4902s1.4902-.6672 1.4902-1.4902V16.371c.3234.4657.6684.8945 1.2774.8945.7955 0 1.093-.7287 1.4843-1.3203.6878-1.4704 1.0743-3.1245 1.0743-4.873C22.5518 4.9569 17.8284 0 12.001 0zm-.5664 2.877c2.8797 0 5.2148 2.7836 5.2148 5.8066 0 3.023-1.5455 5.1504-5.2148 5.1504-3.6693 0-5.2149-2.1274-5.2149-5.1504S8.5548 2.877 11.4346 2.877zM10.0322 4.537a1.9554 2.1583 0 00-1.955 2.1582 1.9554 2.1583 0 001.955 2.1582 1.9554 2.1583 0 001.9551-2.1582 1.9554 2.1583 0 00-1.955-2.1582zm-.3261.664a.9777.9961 0 01.9785.9962.9777.9961 0 01-.9785.996.9777.9961 0 01-.9766-.996.9777.9961 0 01.9766-.9961zM6.7568 15.6935c-1.0746 0-1.2724 1.3542-1.9511 1.9648v1.7813c0 .823.6672 1.4902 1.4902 1.4902s1.4902-.6672 1.4902-1.4902v-3.1817c-.2643-.3237-.5767-.5644-1.0293-.5644Z" },
  { name: "Linux", icon: "fa-brands fa-linux" },
  { name: "Git", icon: "fa-brands fa-git-alt" },
  { name: "nodeJS", icon:"fa-brands fa-node-js" },
  { name: "mySQL", icon: "fa-solid fa-database" },
  { name: "Stripe", icon: "fa-brands fa-stripe-s" },
  { name: "Python", icon:"fa-brands fa-python" },
  { name: "NPM", icon:"fa-brands fa-npm" },
  { name: "CI/CD", icon: "fa-solid fa-arrows-spin" },
];

const whyMeCards = [
  {
    icon: "fa-solid fa-shield-halved",
    title: "Security-First Approach",
    text: "Every line of code is written with security in mind. From secure architecture design to automated vulnerability scanning, I embed protection into the development lifecycle — not as an afterthought, but as a foundation."
  },
  {
    icon: "fa-solid fa-bolt",
    title: "Fast & Reliable Delivery",
    text: "I combine agile workflows with CI/CD pipelines to deliver production-ready features quickly. You get clean, tested code on schedule — without sacrificing quality or cutting corners."
  },
  {
    icon: "fa-solid fa-layer-group",
    title: "Full Stack Expertise",
    text: "From responsive front-ends to robust back-end APIs and cloud infrastructure, I handle the entire stack. One point of contact, one cohesive vision — no gaps between design and deployment."
  },
  {
    icon: "fa-solid fa-handshake",
    title: "Clear Communication",
    text: "No jargon, no disappearing acts. I keep you in the loop with transparent updates, honest timelines, and straightforward explanations — so you always know where your project stands."
  },
];
---

<Layout title="About Me" description="Learn about Alessio Miccichè — a full stack developer and DevSecOps consultant based in Belgium, specialising in secure and scalable web solutions.">
  <Navbar />
  <main class="container">
    <!-- Bio and profile picture -->
    <section class="about-section">
      <p class="section-label">cat about.txt</p>
      <h1 class="section-title" data-i18n="about.title">About Me</h1>
      <div class="aboutcontent">
        <div class="about-text">
          <p data-i18n="about.paragraphs.0">Hi, I'm Alessio, a freelance full stack developer and DevSecOps consultant based in Belgium. With experience across the tech industry, I specialise in building secure, scalable web applications and infrastructure for clients across Europe and beyond.</p>
          <p data-i18n="about.paragraphs.1">My journey in tech started with a passion for coding and problem-solving, which led me to explore various programming languages and frameworks. Over the years, I've honed my skills in both front-end and back-end development, as well as cloud architecture and security best practices.</p>
          <p data-i18n="about.paragraphs.2">When I'm not coding, you can find me exploring the latest trends in technology, contributing to open source projects, or enjoying the great outdoors. I'm always eager to take on new challenges and collaborate with like-minded individuals to create impactful solutions.</p>
        </div>
        <div class="profile-pic-wrapper">
          <img src="/img/AboutMeAvatar.webp" data-i18n-aria="about.profileAlt" alt="Profile Picture" class="profile-pic" width="300" height="300" />
        </div>
      </div>
    </section>

    <!-- Logo explanation -->
    <section class="logo-section">
      <p class="section-label">chmod gordian</p>
      <h2 class="section-title" data-i18n="about.logoTitle">The Symbol</h2>
      <div class="logo-card">
        <div class="logo-card-img">
          <img src="/img/gordian-logo.webp" alt="Gordian Knot logo" width="160" height="160" />
        </div>
        <div class="logo-card-text">
          <h3 data-i18n="about.logoSubtitle">Why the Gordian Knot?</h3>
          <p data-i18n="about.logoText0">
            The Gordian Knot is an ancient symbol of a problem so complex it appears unsolvable — until you change how you look at it.
            Alexander the Great didn't untie the knot. He cut it. One decisive move where everyone else saw an impossible puzzle.
          </p>
          <p data-i18n="about.logoText1">
            That's the mindset I bring to every project. Where others see tangled architecture, legacy constraints, or security gaps,
            I find the clean cut — the direct solution that cuts through complexity without overcomplicating the fix.
          </p>
          <div class="logo-tag-row">
            <span class="logo-tag">Decisive</span>
            <span class="logo-tag">Security-first</span>
            <span class="logo-tag">Cut the noise</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Technologies and tools -->
    <section class="stack-section">
      <p class="section-label">ls --tech-stack</p>
      <h2 class="section-title" data-i18n="about.stackTitle">Tech Stack</h2>
      <p class="section-subtitle" data-i18n="about.stackSubtitle">The tools and technologies I use to bring ideas to life.</p>
      <div class="stack-grid">
        {techStack.map((tech) => (
          <div class="stack-block">
            {tech.icon === "custom-svg" ? (
              /* Handmatige Tailwind SVG omdat de CDN versie 7.2.0 niet ondersteunt */
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d={tech.svgPath} />
              </svg>
            ) : tech.icon === "custom-svg-raw" ? (
              /* Multi-path gekleurde SVGs (bv. Livewire) */
                <svg viewBox={tech.viewBox} xmlns="http://www.w3.org/2000/svg" set:html={tech.svgMarkup} style="filter: brightness(0) invert(1); opacity: 0.6;" />
            ) : (
              /* Standaard FontAwesome iconen */
              <i class={tech.icon}></i>
            )}
            <span>{tech.name}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Differentiators -->
    <section class="why-section">
      <p class="section-label">grep --why-choose-me</p>
      <h2 class="section-title" data-i18n="about.whyTitle">Why Me?</h2>
      <p class="section-subtitle" data-i18n="about.whySubtitle">Here's what sets me apart from the rest.</p>
      <div class="why-grid">
        {whyMeCards.map((card, i) => (
          <div class="why-card">
            <div class="why-card-icon">
              <i class={card.icon}></i>
            </div>
            <h3 data-i18n={`about.whyCards.${i}.title`}>{card.title}</h3>
            <p data-i18n={`about.whyCards.${i}.text`}>{card.text}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* Section label — defined in global.css, mirrored here for scoping */
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    color: var(--cyber-green);
    text-transform: uppercase;
    margin: 0 0 6px;
  }
  .section-label::before { content: '> '; }

  .section-title {
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--text-primary);
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0 0 8px;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 1rem;
    margin-bottom: 26px;
    line-height: 1.6;
  }

  /* Bio section */
  .about-section {
    padding-top: 24px;
    margin-bottom: 60px;
  }

  .aboutcontent {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 48px;
    margin-top: 24px;
  }

  .about-text { flex: 1; }

  .about-text p {
    color: var(--text-secondary);
    font-family: var(--font-body);
    line-height: 1.8;
    margin-bottom: 16px;
    font-size: 1rem;
  }

  /* Profile picture */
  .profile-pic-wrapper {
    flex-shrink: 0;
    width: 180px;
    height: 180px;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--cyber-green), var(--cyber-cyan));
    padding: 2px;
    box-shadow: var(--glow-green);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .profile-pic-wrapper:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 16px rgba(0, 212, 255, 0.4), 0 0 50px rgba(0, 212, 255, 0.1);
  }

  .profile-pic {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    object-fit: cover;
    background: var(--bg-surface);
    display: block;
  }

  /* Logo section */
  .logo-section { margin-bottom: 60px; }

  .logo-card {
    display: flex;
    gap: 40px;
    align-items: center;
    padding: 32px 36px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    margin-top: 20px;
    transition: border-color 0.3s, box-shadow 0.3s;
    position: relative;
    overflow: hidden;
  }

  .logo-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--cyber-cyan), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .logo-card:hover { border-color: var(--border-cyan); box-shadow: var(--glow-cyan); }
  .logo-card:hover::before { opacity: 1; }

  .logo-card-img {
    flex-shrink: 0;
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    transition: opacity 0.3s;
  }

  .logo-card:hover .logo-card-img { opacity: 1; }

  .logo-card-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .logo-card-text { flex: 1; }

  .logo-card-text h3 {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--cyber-cyan);
    margin: 0 0 14px;
    letter-spacing: -0.02em;
  }

  .logo-card-text p {
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.97rem;
    line-height: 1.8;
    margin: 0 0 12px;
  }

  .logo-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .logo-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyber-cyan);
    border: 1px solid var(--border-cyan);
    border-radius: 3px;
    padding: 3px 10px;
  }

  @media (max-width: 600px) {
    .logo-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 24px 20px;
    }
    .logo-card-img { width: 100px; height: 100px; }
  }

  /* Tech stack */
  .stack-section { margin-bottom: 60px; }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 12px;
  }

  .stack-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 20px 10px;
    border-radius: 6px;
    cursor: default;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }

  .stack-block:hover {
    transform: translateY(-4px);
    border-color: var(--border-green);
    box-shadow: var(--glow-green);
  }

  .stack-block i {
    font-size: 1.6rem;
    color: var(--text-secondary);
    transition: color 0.25s;
  }

  .stack-block:hover i {
    color: var(--cyber-green);
    filter: drop-shadow(0 0 4px var(--cyber-green));
  }

  .stack-block svg {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--text-secondary);
    fill: currentColor;
    transition: color 0.25s, filter 0.25s;
  }

  .stack-block:hover svg {
    color: var(--cyber-green);
    filter: drop-shadow(0 0 4px var(--cyber-green));
  }

  .stack-block span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-dim);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.25s;
  }

  .stack-block:hover span { color: var(--cyber-green); }

  /* Why Me cards */
  .why-section { margin-bottom: 20px; }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .why-card {
    padding: 28px 24px;
    border-radius: 6px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }

  /* Top accent line reveals on hover */
  .why-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--cyber-green), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .why-card:hover {
    border-color: var(--border-green);
    transform: translateY(-4px);
    box-shadow: var(--glow-green);
  }

  .why-card:hover::before { opacity: 1; }

  .why-card-icon {
    width: 42px;
    height: 42px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    background: rgba(0, 212, 255, 0.06);
    border: 1px solid var(--border-green);
  }

  .why-card-icon i {
    font-size: 1.1rem;
    color: var(--cyber-green);
  }

  .why-card h3 {
    font-family: var(--font-mono);
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .why-card p {
    font-family: var(--font-body);
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.75;
    margin: 0;
  }

  /* Mobile */
  @media (max-width: 700px) {
    .aboutcontent { flex-direction: column; align-items: center; text-align: center; }
    .profile-pic-wrapper { order: -1; width: 150px; height: 150px; }
    .why-grid { grid-template-columns: 1fr; }
    .stack-grid { grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; }
    .stack-block { padding: 16px 8px; }
  }
</style>