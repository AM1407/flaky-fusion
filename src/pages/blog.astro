---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
import blogs from '../data/blogs.json';

// Sort posts by date, newest first
const sortedBlogs = [...blogs].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="Blog" description="Articles on web security, DevSecOps, infrastructure as code, and modern web development by Alessio Miccichè.">
  <Navbar />
  <main class="container">
    <header class="blog-header">
      <h1 class="page-title" data-i18n="blog.title">Blog</h1>
      <p class="page-subtitle" data-i18n="blog.subtitle">Thoughts on security, infrastructure, and modern web development.</p>
    </header>

    <!-- Search and date filter controls -->
    <div class="controls">
      <div class="search-bar">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input
          type="text"
          id="search-input"
          placeholder="Search posts..."
          data-i18n-placeholder="blog.searchPlaceholder"
          autocomplete="off"
          maxlength="120"
          aria-label="Search blog posts"
        />
        <button id="search-clear" class="search-clear" aria-label="Clear search" style="display:none;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="filter-row">
        <div class="date-filter">
          <label for="date-from" data-i18n="blog.filterFrom">From</label>
          <input type="date" id="date-from" aria-label="Filter from date" />
        </div>
        <div class="date-filter">
          <label for="date-to" data-i18n="blog.filterTo">To</label>
          <input type="date" id="date-to" aria-label="Filter to date" />
        </div>
        <button id="clear-filters" class="clear-filters-btn" data-i18n="blog.clearFilters">Clear Filters</button>
      </div>
    </div>

    <!-- Blog cards rendered via client-side JS -->
    <div class="blog-list" id="blog-list"></div>

    <!-- No results message -->
    <div class="empty-state" id="empty-state" style="display:none;">
      <i class="fa-solid fa-magnifying-glass"></i>
      <p data-i18n="blog.noResults">No posts match your search.</p>
    </div>

    <!-- Page navigation -->
    <nav class="pagination" id="pagination" aria-label="Blog pagination"></nav>
  </main>
  <Footer />
</Layout>

<!-- Inject blog data for client-side rendering -->
<script is:inline define:vars={{ blogData: sortedBlogs }}>
  window.__BLOG_DATA__ = blogData;
</script>

<script>
  import { locale } from '../stores/languageStore';
  import { t, tObj } from '../i18n/index';

  document.addEventListener('DOMContentLoaded', () => {
    const POSTS_PER_PAGE = 4;
    const allPosts: Array<{slug:string; title:string; excerpt:string; image:string; date:string; author:string; tags:string[]; lang?: string}> = (window as any).__BLOG_DATA__;

    const listEl = document.getElementById('blog-list')!;
    const paginationEl = document.getElementById('pagination')!;
    const emptyEl = document.getElementById('empty-state')!;
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const searchClear = document.getElementById('search-clear')!;
    const dateFrom = document.getElementById('date-from') as HTMLInputElement;
    const dateTo = document.getElementById('date-to') as HTMLInputElement;
    const clearFilters = document.getElementById('clear-filters')!;

    let currentPage = 1;

    // Return translated title/excerpt if available, otherwise use the original
    function getTranslatedPost(post: typeof allPosts[0]) {
      const lang = locale.get();
      const blogPosts = tObj('blog.posts', lang) as Array<{slug:string; title:string; excerpt:string}> | undefined;
      if (blogPosts) {
        const translated = blogPosts.find(p => p.slug === post.slug);
        if (translated) {
          return { ...post, title: translated.title, ...(translated.excerpt ? { excerpt: translated.excerpt } : {}) };
        }
      }
      return post;
    }

    // Escape HTML entities to prevent XSS
    function esc(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // Remove non-printable characters and cap input length
    function sanitiseQuery(raw: string): string {
      return raw.replace(/[^\x20-\x7E\u00C0-\u024F]/g, '').trim().slice(0, 120);
    }

    // Apply search query and date range filters to the post list
    function getFilteredPosts() {
      const lang = locale.get();
      const query = sanitiseQuery(searchInput.value).toLowerCase();
      const from = dateFrom.value ? new Date(dateFrom.value) : null;
      const to = dateTo.value ? new Date(dateTo.value + 'T23:59:59') : null;

      return allPosts.filter((post) => {
        // Language filter: hide posts tagged for another language
        if (post.lang && post.lang !== 'both' && post.lang !== lang) return false;

        const tp = getTranslatedPost(post);
        // Match against title, excerpt, and tags
        if (query) {
          const haystack = `${tp.title} ${tp.excerpt} ${post.tags.join(' ')}`.toLowerCase();
          if (!haystack.includes(query)) return false;
        }
        // Exclude posts outside the selected date range
        const postDate = new Date(post.date);
        if (from && postDate < from) return false;
        if (to && postDate > to) return false;
        return true;
      });
    }

    // Build and insert blog card HTML for the current page
    // SECURITY NOTE: All dynamic values are escaped via esc() before insertion into innerHTML
    function renderCards(posts: typeof allPosts, page: number) {
      const lang = locale.get();
      const readMoreText = t('blog.readMore', lang);
      const start = (page - 1) * POSTS_PER_PAGE;
      const pageSlice = posts.slice(start, start + POSTS_PER_PAGE);

      if (posts.length === 0) {
        listEl.innerHTML = '';
        emptyEl.style.display = 'flex';
        paginationEl.innerHTML = '';
        return;
      }
      emptyEl.style.display = 'none';

      listEl.innerHTML = pageSlice.map((post, i) => {
        const tp = getTranslatedPost(post);
        const globalIndex = start + i;
        const dir = globalIndex % 2 === 0 ? 'img-left' : 'img-right';
        const dateLocale = lang === 'nl' ? 'nl-BE' : 'en-GB';
        const dateFormatted = new Date(post.date).toLocaleDateString(dateLocale, { day: 'numeric', month: 'long', year: 'numeric' });
        const tagsHtml = post.tags.map((tag) => `<span class="tag">${esc(tag)}</span>`).join('');

        return `
          <article class="blog-card ${dir}">
            <div class="card-image">
              <img src="${esc(post.image)}" alt="${esc(tp.title)}" width="600" height="400" loading="lazy" />
            </div>
            <div class="card-body">
              <div class="card-meta">
                <time datetime="${esc(post.date)}">${esc(dateFormatted)}</time>
                <div class="card-tags">${tagsHtml}</div>
              </div>
              <h2 class="card-title">${esc(tp.title)}</h2>
              <p class="card-excerpt">${esc(tp.excerpt)}</p>
              <a href="/blog/${encodeURIComponent(post.slug)}" class="read-more">
                ${esc(readMoreText)} <span class="arrow">&rarr;</span>
              </a>
            </div>
          </article>
        `;
      }).join('');

      // Stagger card entrance animations
      requestAnimationFrame(() => {
        listEl.querySelectorAll('.blog-card').forEach((card, i) => {
          setTimeout(() => card.classList.add('in-view'), i * 100);
        });
      });
    }

    // Build pagination buttons with prev/next navigation
    function renderPagination(totalPosts: number, page: number) {
      const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);
      if (totalPages <= 1) { paginationEl.innerHTML = ''; return; }

      let html = '';

      // Previous page button
      html += `<button class="page-btn ${page <= 1 ? 'disabled' : ''}" data-page="${page - 1}" ${page <= 1 ? 'disabled' : ''} aria-label="Previous page">&laquo;</button>`;

      for (let p = 1; p <= totalPages; p++) {
        html += `<button class="page-btn ${p === page ? 'active' : ''}" data-page="${p}" aria-label="Page ${p}">${p}</button>`;
      }

      // Next page button
      html += `<button class="page-btn ${page >= totalPages ? 'disabled' : ''}" data-page="${page + 1}" ${page >= totalPages ? 'disabled' : ''} aria-label="Next page">&raquo;</button>`;

      paginationEl.innerHTML = html;

      paginationEl.querySelectorAll('.page-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = Number((btn as HTMLElement).dataset.page);
          if (target >= 1 && target <= totalPages) {
            currentPage = target;
            update();
            listEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    }

    // Re-filter and re-render the visible posts
    function update() {
      const filtered = getFilteredPosts();
      const totalPages = Math.ceil(filtered.length / POSTS_PER_PAGE);
      if (currentPage > totalPages) currentPage = Math.max(1, totalPages);
      renderCards(filtered, currentPage);
      renderPagination(filtered.length, currentPage);
    }

    // Event listeners for search, date filters, and clear button
    let debounceTimer: ReturnType<typeof setTimeout>;
    searchInput.addEventListener('input', () => {
      searchClear.style.display = searchInput.value ? 'flex' : 'none';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => { currentPage = 1; update(); }, 250);
    });

    searchClear.addEventListener('click', () => {
      searchInput.value = '';
      searchClear.style.display = 'none';
      currentPage = 1;
      update();
      searchInput.focus();
    });

    dateFrom.addEventListener('change', () => { currentPage = 1; update(); });
    dateTo.addEventListener('change', () => { currentPage = 1; update(); });

    clearFilters.addEventListener('click', () => {
      searchInput.value = '';
      searchClear.style.display = 'none';
      dateFrom.value = '';
      dateTo.value = '';
      currentPage = 1;
      update();
    });

    // Block Enter key from submitting the search form
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') e.preventDefault();
    });

    // Update cards when language changes
    locale.listen(() => {
      update();
    });

    // Render the initial view
    update();
  });
</script>

<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* Page header */
  .blog-header {
    padding: 24px 0 28px;
  }

  .page-title {
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--text-primary);
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin: 0 0 8px;
    letter-spacing: -0.03em;
  }

  .page-title::before {
    content: '> ';
    color: var(--cyber-green);
    font-size: 0.6em;
    vertical-align: middle;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 1rem;
    margin: 0;
  }

  /* Controls */
  .controls {
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .search-bar {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    padding: 0 12px;
    transition: border-color 0.2s;
  }

  .search-bar:focus-within {
    border-color: var(--border-green);
    box-shadow: 0 0 0 2px rgba(0, 212, 255, 0.06);
  }

  .search-icon {
    color: var(--text-dim);
    font-size: 0.82rem;
    flex-shrink: 0;
  }

  .search-bar input {
    flex: 1;
    padding: 12px 10px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    outline: none;
    caret-color: var(--cyber-green);
  }

  .search-bar input::placeholder { color: var(--text-dim); }

  .search-clear {
    background: transparent;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 0.82rem;
    padding: 4px 6px;
    transition: color 0.2s;
    flex-shrink: 0;
  }

  .search-clear:hover { color: var(--cyber-red); }

  .filter-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .date-filter {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .date-filter input[type="date"] {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 4px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 6px 10px;
    outline: none;
    transition: border-color 0.2s;
  }

  .date-filter input[type="date"]:focus {
    border-color: var(--border-green);
  }

  .date-filter input[type="date"]::-webkit-calendar-picker-indicator {
    filter: invert(0.5);
    cursor: pointer;
  }

  .clear-filters-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--cyber-red);
    border: 1px solid rgba(255, 0, 60, 0.2);
    border-radius: 4px;
    padding: 6px 12px;
    background: transparent;
    cursor: pointer;
    transition: background 0.2s;
    text-transform: uppercase;
  }

  .clear-filters-btn:hover { background: rgba(255, 0, 60, 0.06); }

  /* Empty state */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    gap: 16px;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .empty-state i { font-size: 2rem; }

  .empty-state p { font-size: 0.9rem; margin: 0; }

  /* Blog list */
  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Cards rendered by JS — use :global() for dynamically-inserted classes */
  .blog-list :global(.blog-card) {
    display: flex;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    overflow: hidden;
    opacity: 0;
    transform: translateY(16px);
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
  }

  .blog-list :global(.blog-card.in-view) {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease,
      border-color 0.25s,
      box-shadow 0.25s;
  }

  .blog-list :global(.blog-card:hover) {
    border-color: var(--border-green);
    box-shadow: var(--glow-green);
    transform: translateX(4px);
  }

  .blog-list :global(.blog-card.img-left)  { flex-direction: row; }
  .blog-list :global(.blog-card.img-right) { flex-direction: row-reverse; }

  /* Card thumbnail */
  .blog-list :global(.card-image) {
    flex: 0 0 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface-2);
    padding: 12px;
    overflow: hidden;
  }

  .blog-list :global(.card-image img) {
    width: 100%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.5));
    transition: transform 0.3s ease;
  }

  .blog-list :global(.blog-card:hover .card-image img) {
    transform: scale(1.04);
  }

  /* Card body */
  .blog-list :global(.card-body) {
    flex: 1;
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  .blog-list :global(.card-meta) {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .blog-list :global(.card-meta time) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .blog-list :global(.card-tags) {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .blog-list :global(.tag) {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    padding: 2px 8px;
    border-radius: 3px;
    border: 1px solid var(--border-cyan);
    color: var(--cyber-cyan);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(0, 212, 255, 0.04);
  }

  .blog-list :global(.card-title) {
    font-family: var(--font-mono);
    color: var(--text-primary);
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .blog-list :global(.card-excerpt) {
    font-family: var(--font-body);
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 0;
  }

  .blog-list :global(.read-more) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--cyber-green);
    border: 1px solid var(--border-green);
    border-radius: 4px;
    padding: 7px 16px;
    background: rgba(0, 212, 255, 0.04);
    width: fit-content;
    transition: background 0.2s, box-shadow 0.2s;
  }

  .blog-list :global(.read-more::before) { content: '>_ '; }

  .blog-list :global(.read-more:hover) {
    background: rgba(0, 212, 255, 0.08);
    box-shadow: var(--glow-green);
  }

  .blog-list :global(.read-more .arrow) { display: none; }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 40px;
  }

  .pagination :global(.page-btn) {
    min-width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    border: 1px solid var(--border-dim);
    background: var(--bg-surface);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, box-shadow 0.2s;
  }

  .pagination :global(.page-btn:hover:not(.disabled):not(.active)) {
    border-color: var(--border-green);
    color: var(--cyber-green);
  }

  .pagination :global(.page-btn.active) {
    border-color: var(--border-green);
    color: var(--cyber-green);
    box-shadow: var(--glow-green);
  }

  .pagination :global(.page-btn.disabled) {
    opacity: 0.25;
    cursor: not-allowed;
  }

  /* Mobile */
  @media (max-width: 700px) {
    .blog-list :global(.blog-card.img-left),
    .blog-list :global(.blog-card.img-right) { flex-direction: column; }
    .blog-list :global(.card-image) { flex: none; padding: 12px; }
    .blog-list :global(.card-image img) { max-width: 160px; }
    .blog-list :global(.card-body) { padding: 18px 20px 22px; }
    .blog-list :global(.card-title) { font-size: 1rem; }
    .filter-row { flex-direction: column; align-items: stretch; }
  }
</style>