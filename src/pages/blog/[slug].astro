---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/navbar.astro';
import Footer from '../../components/footer.astro';
import blogs from '../../data/blogs.json';
import nlI18n from '../../i18n/nl.json';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  return blogs.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

if (!post) {
  return Astro.redirect('/404');
}

const postsDir = path.resolve('src/data/posts');

function readFile(slug: string, suffix: string): string {
  try {
    return fs.readFileSync(path.join(postsDir, `${slug}${suffix}`), 'utf-8').replace(/\r\n/g, '\n');
  } catch { return ''; }
}

// Language-specific files take priority; fall back to base .txt for EN, then empty
const contentEN = readFile(post.slug, '.en.txt') || readFile(post.slug, '.txt');
const contentNL = readFile(post.slug, '.nl.txt') || contentEN;

type PostBlock =
  | { type: 'p'; text: string }
  | { type: 'h2'; text: string }
  | { type: 'h3'; text: string }
  | { type: 'quote'; text: string }
  | { type: 'quote-list'; intro: string; items: string[] }
  | { type: 'ul'; items: string[] };

function parseBlocks(txt: string): PostBlock[] {
  return txt
    .split(/\n{2,}/)
    .map((block) => block.trim())
    .filter(Boolean)
    .map((block) => {
      const lines = block.split(/\n+/).map((line) => line.trim()).filter(Boolean);
      const firstLine = lines[0] ?? '';

      if (lines.every((line) => /^[-*]\s+/.test(line))) {
        return { type: 'ul', items: lines.map((line) => line.replace(/^[-*]\s+/, '')) };
      }

      if (firstLine.startsWith('### ')) {
        return { type: 'h3', text: firstLine.slice(4) };
      }

      if (firstLine.startsWith('## ')) {
        return { type: 'h2', text: firstLine.slice(3) };
      }

      if (firstLine.startsWith('>')) {
        const bulletLines = lines.filter((l) => /^>\s*[-*]\s+/.test(l)).map((l) => l.replace(/^>\s*[-*]\s+/, ''));
        if (bulletLines.length > 0) {
          const intro = lines.filter((l) => !/^>\s*[-*]\s+/.test(l)).map((l) => l.replace(/^>\s*/, '')).join(' ');
          return { type: 'quote-list', intro, items: bulletLines };
        }
        return { type: 'quote', text: lines.map((line) => line.replace(/^>\s*/, '')).join(' ') };
      }

      return { type: 'p', text: lines.join(' ') };
    });
}

function renderInline(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
}

const blocksEN = parseBlocks(contentEN);
const blocksNL = parseBlocks(contentNL);

const hasNL = !!readFile(post.slug, '.nl.txt');

type I18nPost = { slug: string; title: string };
const nlPosts = (nlI18n as any).blog?.posts as I18nPost[] | undefined;
const titleNL = nlPosts?.find(p => p.slug === post.slug)?.title ?? post.title;
---

<Layout title={`${post.title} | Blog`} description={post.excerpt}>
  <Navbar />

  <main>
  <article class="post-container">
    <a href="/blog" class="back-link" data-i18n="blog.backToBlog">&larr; Back to Blog</a>

    <header class="post-header">
      <div class="post-meta">
        <time id="post-date" datetime={post.date}>
          {new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <span class="meta-sep">·</span>
        <span class="author">{post.author}</span>
      </div>
      <h1 class="post-title" id="post-title" data-title-en={post.title} data-title-nl={titleNL}>{post.title}</h1>
      <div class="post-tags">
        {post.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>

    <div class="post-hero">
      <img src={post.image} alt={post.title} width="760" height="400" loading="lazy" />
    </div>

    <!-- EN content -->
    <div id="post-body-en" class="post-body">
      {blocksEN.length > 0
        ? blocksEN.map((block) => {
            if (block.type === 'h2') return <h2 set:html={renderInline(block.text)} />;
            if (block.type === 'h3') return <h3 set:html={renderInline(block.text)} />;
            if (block.type === 'quote') return <blockquote set:html={renderInline(block.text)} />;
            if (block.type === 'quote-list') return <blockquote>{block.intro && <p set:html={renderInline(block.intro)} />}<ul>{block.items.map((item) => <li set:html={renderInline(item)} />)}</ul></blockquote>;
            if (block.type === 'ul') return <ul>{block.items.map((item) => <li set:html={renderInline(item)} />)}</ul>;
            return <p set:html={renderInline(block.text)} />;
          })
        : <p class="no-content">Content coming soon.</p>}
    </div>

    <!-- NL content (hidden by default, shown when locale = nl) -->
    <div id="post-body-nl" class="post-body" style="display:none">
      {blocksNL.length > 0
        ? blocksNL.map((block) => {
            if (block.type === 'h2') return <h2 set:html={renderInline(block.text)} />;
            if (block.type === 'h3') return <h3 set:html={renderInline(block.text)} />;
            if (block.type === 'quote') return <blockquote set:html={renderInline(block.text)} />;
            if (block.type === 'quote-list') return <blockquote>{block.intro && <p set:html={renderInline(block.intro)} />}<ul>{block.items.map((item) => <li set:html={renderInline(item)} />)}</ul></blockquote>;
            if (block.type === 'ul') return <ul>{block.items.map((item) => <li set:html={renderInline(item)} />)}</ul>;
            return <p set:html={renderInline(block.text)} />;
          })
        : <p class="no-content">Inhoud volgt binnenkort.</p>}
    </div>
  </article>
  </main>

  <Footer />
</Layout>

<script define:vars={{ postDate: post.date }}>
  (function () {
    const lang = localStorage.getItem('lang') || 'en';
    applyLang(lang);

    function applyLang(lang) {
      const enEl = document.getElementById('post-body-en');
      const nlEl = document.getElementById('post-body-nl');
      if (enEl) enEl.style.display = lang === 'nl' ? 'none' : 'block';
      if (nlEl) nlEl.style.display = lang === 'nl' ? 'block' : 'none';

      const titleEl = document.getElementById('post-title');
      if (titleEl) {
        const t = lang === 'nl' ? titleEl.dataset.titleNl : titleEl.dataset.titleEn;
        if (t) titleEl.textContent = t;
      }

      const dateEl = document.getElementById('post-date');
      if (dateEl) {
        dateEl.textContent = new Date(postDate).toLocaleDateString(
          lang === 'nl' ? 'nl-BE' : 'en-GB',
          { day: 'numeric', month: 'long', year: 'numeric' }
        );
      }
    }

    window.addEventListener('locale-changed', (e) => applyLang(e.detail));
  })();
</script>

<style>
  .post-container {
    max-width: 760px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--cyber-cyan);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 32px;
    transition: opacity 0.2s;
  }

  .back-link:hover { opacity: 0.7; }

  .post-header { margin-bottom: 32px; }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .meta-sep { opacity: 0.35; }

  .post-title {
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--text-primary);
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 16px;
    letter-spacing: -0.03em;
  }

  .post-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 3px;
    background: rgba(0, 212, 255, 0.06);
    border: 1px solid var(--border-cyan);
    color: var(--cyber-cyan);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-hero {
    margin-bottom: 40px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
  }

  .post-hero img {
    max-width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.5));
  }

  .post-body p {
    font-family: var(--font-body);
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.85;
    margin: 0 0 24px;
  }

  .post-body p:first-child {
    font-size: 1.12rem;
    color: var(--text-primary);
    line-height: 1.75;
  }

  .post-body :global(h2) {
    margin: 2.4rem 0 1rem;
    font-family: var(--font-mono);
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .post-body :global(h3) {
    margin: 2rem 0 0.85rem;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--cyber-cyan);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .post-body :global(blockquote) {
    margin: 1.4rem 0 2rem;
    padding: 18px 22px;
    border-left: 3px solid var(--cyber-cyan);
    background: rgba(0, 212, 255, 0.05);
    border-radius: 0 10px 10px 0;
    color: var(--text-primary);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .post-body :global(ul) {
    margin: 0 0 1.8rem;
    padding-left: 1.25rem;
  }

  .post-body :global(li) {
    margin-bottom: 0.65rem;
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .no-content {
    color: var(--text-dim) !important;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .post-container { padding: 24px 16px 60px; }
    .post-hero { padding: 20px; }
  }
</style>
