---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
import ContactForm from '../components/ContactForm';
---

<Layout title="Contact | Alessio Miccichè" description="Get in touch with Alessio Miccichè for full stack development, DevSecOps consulting, or secure infrastructure projects.">
  <Navbar />
  
  <main class="contact-main">
    <header class="contact-header">
      <span class="label" data-i18n="contact.label">CONTACT</span>
      <h1 data-i18n="contact.title">Get in touch.</h1>
      <p class="subtitle" data-i18n="contact.subtitle">Have a project, question, or just want to say hi? Drop me a line.</p>
    </header>

    <div class="contact-wrapper">
      {/* Contact details sidebar */}
      <aside class="contact-aside">
        <div class="aside-block">
          <h3 data-i18n="contact.emailLabel">Email</h3>
          <a href="mailto:micciche.alessio@outlook.com">
            <i class="fa-regular fa-envelope"></i>
            micciche.alessio@outlook.com
          </a>
        </div>

        <div class="aside-block">
          <h3 data-i18n="contact.locationLabel">Location</h3>
          <span>
            <i class="fa-solid fa-location-dot"></i>
            <span data-i18n="contact.location">Zutendaal, Belgium</span>
          </span>
        </div>

        <div class="aside-block">
          <h3 data-i18n="contact.faqLabel">FAQ</h3>
          <a href="/faq" class="faq-link">
            <i class="fa-solid fa-circle-question"></i>
            <span data-i18n="contact.faqLink">Frequently Asked Questions</span>
          </a>
        </div>

        <div class="aside-socials">
          <a href="https://www.linkedin.com/in/alessio-micciche/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <i class="fa-brands fa-linkedin"></i>
          </a>
          <a href="https://github.com/AM1407" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <i class="fa-brands fa-github"></i>
          </a>
        </div>
      </aside>

      {/* Contact form */}
      <div class="form-wrapper">
        <ContactForm client:load />
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Page layout */
  .contact-main {
    max-width: 960px;
    margin: 0 auto;
    padding: 24px 5% 80px;
  }

  /* Header */
  .contact-header {
    margin-bottom: 36px;
  }

  .contact-header .label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cyber-green);
    margin-bottom: 8px;
  }

  .contact-header .label::before { content: '> '; }

  .contact-header h1 {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 10px;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .contact-header .subtitle {
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 1rem;
    margin: 0;
    max-width: 440px;
  }

  /* Two-column layout */
  .contact-wrapper {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 48px;
    align-items: start;
  }

  /* Sidebar */
  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .aside-block {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    padding: 18px 20px;
    transition: border-color 0.25s;
  }

  .aside-block:hover { border-color: var(--border-green); }

  .aside-block h3 {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--cyber-green);
    margin: 0 0 10px;
  }

  .aside-block h3::before { content: '> '; }

  .aside-block a,
  .aside-block > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .aside-block a i,
  .aside-block > span i {
    color: var(--cyber-green);
    font-size: 0.9rem;
    width: 14px;
    text-align: center;
    flex-shrink: 0;
  }

  .aside-block a:hover { color: var(--cyber-green); }

  .faq-link { color: var(--cyber-cyan) !important; }
  .faq-link:hover { color: var(--cyber-green) !important; }

  /* Socials */
  .aside-socials {
    display: flex;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--border-dim);
    margin-top: 4px;
  }

  .aside-socials a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px; height: 34px;
    border-radius: 4px;
    border: 1px solid var(--border-dim);
    color: var(--text-secondary);
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .aside-socials a:hover {
    color: var(--cyber-green);
    border-color: var(--border-green);
    box-shadow: var(--glow-green);
  }

  /* Form wrapper */
  .form-wrapper {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    padding: 32px;
  }

  .contact-form-island {
    display: flex;
    flex-direction: column;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 18px;
  }

  .input-group label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyber-green);
  }

  input, select, textarea {
    background: var(--bg-surface-2);
    border: 1px solid var(--border-dim);
    padding: 11px 13px;
    color: var(--text-primary);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    transition: border-color 0.2s, box-shadow 0.2s;
    caret-color: var(--cyber-green);
    width: 100%;
    box-sizing: border-box;
  }

  input::placeholder, textarea::placeholder {
    color: var(--text-dim);
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--border-green);
    box-shadow: 0 0 0 2px rgba(0, 212, 255, 0.06);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-btn {
    width: 100%;
    background: var(--cyber-green);
    color: #050a0e;
    border: none;
    padding: 13px;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 4px;
    cursor: pointer;
    transition: box-shadow 0.25s, transform 0.2s;
    margin-top: 6px;
  }

  .submit-btn:hover {
    box-shadow: var(--glow-green);
    transform: translateY(-2px);
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  /* Toast notifications */
  .toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 20px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-primary);
    z-index: 9999;
    animation: toast-in 0.3s ease, toast-out 0.3s ease 3.6s forwards;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
  }

  .toast-success {
    background: rgba(0, 212, 255, 0.08);
    border: 1px solid var(--border-green);
    color: var(--cyber-green);
  }

  .toast-error {
    background: rgba(255, 0, 60, 0.08);
    border: 1px solid rgba(255, 0, 60, 0.3);
    color: var(--cyber-red);
  }

  @keyframes toast-in {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes toast-out {
    from { opacity: 1; transform: translateY(0); }
    to   { opacity: 0; transform: translateY(16px); }
  }

  /* Mobile */
  @media (max-width: 700px) {
    .contact-wrapper {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .contact-aside {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px;
    }

    .aside-socials {
      border-top: none;
      padding-top: 0;
    }

    .form-row { grid-template-columns: 1fr; }
    .form-wrapper { padding: 22px 20px; }
  }
</style>