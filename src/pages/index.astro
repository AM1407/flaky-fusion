---
import Layout from '../layouts/Layout.astro';
import Splash from '../components/splash.astro';
import Navbar from '../components/navbar.astro';
import Hero from '../components/hero.astro';
import Footer from '../components/footer.astro';
---

<Layout title="Gordian Project" description="Portfolio of Alessio Miccichè — Full Stack Engineer & Aspiring DevSecOps specialist building secure, scalable web applications and cloud infrastructure.">
  <Splash />
  
  <div id="site-wrapper">
    <Navbar />
    
	<Hero />
  </div>

  <Footer />

  <style>
    #site-wrapper {
      opacity: 0;
      visibility: hidden;
      display: flex;
      flex-direction: column;
      height: calc(100vh - 80px);
      height: calc(100dvh - 80px);
      overflow: hidden;
      transition: opacity 0.6s ease-in-out, visibility 0s linear 0s;
    }

    @media (max-width: 768px) {
      #site-wrapper {
        height: auto;
        overflow: visible;
      }
    }

    #site-wrapper.visible {
      opacity: 1;
      visibility: visible;
    }

    #site-wrapper main {
      flex-grow: 1;
    }

    .hero {
      padding: 5rem;
      text-align: center;
    }

    .hero h1 {
      color: white;
      font-size: 2.25rem;
      font-family: monospace;
      text-transform: uppercase;
      letter-spacing: -0.05em;
    }
  </style>

  <script is:inline>
    window.addEventListener('splash-finished', function () {
      var wrapper = document.getElementById('site-wrapper');
      if (wrapper) wrapper.classList.add('visible');
    });

    // Fallback: force-show content if splash event never fires
    setTimeout(function () {
      var wrapper = document.getElementById('site-wrapper');
      if (wrapper && !wrapper.classList.contains('visible')) {
        var overlay = document.getElementById('splash-overlay');
        if (overlay) overlay.style.display = 'none';
        wrapper.classList.add('visible');
      }
    }, 5000);
  </script>
</Layout>