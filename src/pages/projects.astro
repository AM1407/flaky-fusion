---
import Layout from '../layouts/Layout.astro';
import projectsData from '../data/projects.json';
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';

// Bepaal de initiële taal voor Server Side Rendering
const lang = Astro.currentLocale || 'nl'; 

const featured = projectsData.find((p) => p.featured);
const otherProjects = projectsData.filter((p) => !p.featured);
const CARDS_PER_PAGE = 6;
---

<Layout title="Projects" description="Explore projects by Alessio Miccichè — from zero-trust infrastructure deployments to secure API gateways and full stack applications.">
  <Navbar />

  <main>
  <section class="projects-overview">
    <h1 data-i18n="projects.title">Projects</h1>

    {/* Hero card voor featured project */}
    {featured && (
      <a href={`/projects/${featured.id}`} class="featured-card" data-project-id={featured.id}>
        <img
          src={featured.image || "/img/placeholder.jpg"}
          alt={featured.title[lang] || featured.title}
          class="featured-img"
        />
        <div class="featured-body">
          <span class="featured-label" data-i18n="projects.featured">Featured</span>
          <h2 data-field="title">{featured.title[lang] || featured.title}</h2>
          <p data-field="description">{featured.description[lang] || featured.description}</p>
          <div class="tech-stack">
            {featured.stack && featured.stack.map((tech) => (
              <span class="badge">{tech}</span>
            ))}
          </div>
          <span class="card-cta"><span data-i18n="projects.viewProject">View Project</span> &rarr;</span>
        </div>
      </a>
    )}

    {/* Grid van overige projecten */}
    <div class="projects-grid" id="projects-grid">
      {otherProjects.map((project) => (
        <a href={`/projects/${project.id}`} class="project-card" data-card data-project-id={project.id}>
          <img
            src={project.image || "/img/placeholder.jpg"}
            alt={project.title[lang] || project.title}
            class="card-img"
          />
          <div class="card-body">
            <h2 data-field="title">{project.title[lang] || project.title}</h2>
            <p data-field="description">{project.description[lang] || project.description}</p>
            <div class="tech-stack">
              {project.stack && project.stack.map((tech) => (
                <span class="badge">{tech}</span>
              ))}
            </div>
            <span class="card-cta"><span data-i18n="projects.viewProject">View Project</span> &rarr;</span>
          </div>
        </a>
      ))}
    </div>

    {/* Paginatie */}
    {otherProjects.length > CARDS_PER_PAGE && (
      <nav class="pagination" id="pagination" aria-label="Project pages"></nav>
    )}
  </section>
  </main>
  <Footer />
</Layout>

<style>
  main { max-width: 1100px; margin: 0 auto; padding: 0 5% 80px; }

  .projects-overview { padding-top: 24px; }

  .projects-overview h1 {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--text-primary);
    margin: 0 0 8px;
    letter-spacing: -0.03em;
  }

  .projects-overview h1::before {
    content: '> ';
    color: var(--cyber-green);
    font-size: 0.6em;
    vertical-align: middle;
  }

  /* Featured card — terminal window chrome */
  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--border-green);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    margin: 24px 0 40px;
    background: var(--bg-surface);
    transition: box-shadow 0.25s, transform 0.25s;
    position: relative;
  }

  /* Terminal chrome header bar */
  .featured-card::before {
    content: 'featured_project.sh';
    position: absolute;
    top: 0; left: 0; right: 0;
    padding: 7px 14px;
    background: var(--bg-surface-2);
    border-bottom: 1px solid var(--border-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--cyber-green);
    z-index: 1;
  }

  .featured-card:hover {
    box-shadow: var(--glow-green);
    transform: translateY(-3px);
  }

  .featured-img {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
    display: block;
    margin-top: 28px;
  }

  .featured-body {
    padding: 44px 28px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .featured-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cyber-green);
    border: 1px solid var(--border-green);
    border-radius: 3px;
    padding: 2px 8px;
    align-self: flex-start;
  }

  .featured-body h2 {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .featured-body p {
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Tech stack badges */
  .tech-stack {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--cyber-cyan);
    border: 1px solid var(--border-cyan);
    border-radius: 3px;
    padding: 2px 8px;
    text-transform: uppercase;
    background: rgba(0, 212, 255, 0.04);
  }

  .card-cta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--cyber-green);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .card-cta::before { content: '>_ '; }

  /* Project grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s, box-shadow 0.25s, transform 0.25s;
    position: relative;
  }

  /* Terminal chrome bar at top of each card */
  .project-card::before {
    content: '';
    display: block;
    height: 26px;
    background: var(--bg-surface-2);
    border-bottom: 1px solid var(--border-dim);
    flex-shrink: 0;
  }

  .project-card:hover {
    border-color: var(--border-green);
    box-shadow: var(--glow-green);
    transform: translateY(-4px);
  }

  .card-img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
  }

  .card-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .card-body h2 {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .card-body p {
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: 0.87rem;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 32px;
  }

  .pagination :global(button) {
    min-width: 36px;
    height: 36px;
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 4px;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, box-shadow 0.2s;
  }

  .pagination :global(button:hover),
  .pagination :global(button.active) {
    border-color: var(--border-green);
    color: var(--cyber-green);
    box-shadow: var(--glow-green);
  }

  @media (max-width: 768px) {
    .featured-card { grid-template-columns: 1fr; }
    .featured-img  { min-height: 200px; }
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ CARDS_PER_PAGE, projectsData }}>
  // 1. PROJECT VERTALING LOGICA
  function updateProjectTranslations(lang) {
    // Zoek alle elementen met een project-ID (zowel h2 als p)
    const projectContainers = document.querySelectorAll('[data-project-id]');
    
    projectContainers.forEach(container => {
      const projectId = container.getAttribute('data-project-id');
      const project = projectsData.find(p => p.id === projectId);
      
      if (project) {
        // Update Titel
        const titleEl = container.querySelector('[data-field="title"]');
        if (titleEl && project.title[lang]) {
          titleEl.textContent = project.title[lang];
        }
        
        // Update Beschrijving
        const descEl = container.querySelector('[data-field="description"]');
        if (descEl && project.description[lang]) {
          descEl.textContent = project.description[lang];
        }

        // Update Alt-tekst van de afbeelding (optioneel voor SEO)
        const imgEl = container.querySelector('img');
        if (imgEl && project.title[lang]) {
          imgEl.alt = project.title[lang];
        }
      }
    });
  }

  // Luister naar het 'locale-changed' event uit je languageStore.ts
  window.addEventListener('locale-changed', (event) => {
    updateProjectTranslations(event.detail);
  });

  // Run on mount om de opgeslagen taal uit localStorage toe te passen
  const initialLang = localStorage.getItem('lang') || 'en';
  updateProjectTranslations(initialLang);


  // 2. PAGINATIE LOGICA (Bestaand)
  const grid = document.getElementById('projects-grid');
  const paginationNav = document.getElementById('pagination');
  
  if (grid && paginationNav) {
    const cards = Array.from(grid.querySelectorAll('[data-card]'));
    const totalPages = Math.ceil(cards.length / CARDS_PER_PAGE);
    let currentPage = 1;

    function render(page) {
      currentPage = page;
      const start = (page - 1) * CARDS_PER_PAGE;
      const end = start + CARDS_PER_PAGE;

      cards.forEach((card, i) => {
        card.style.display = i >= start && i < end ? '' : 'none';
      });

      paginationNav.innerHTML = '';
      if (totalPages > 1) {
        for (let p = 1; p <= totalPages; p++) {
          const btn = document.createElement('button');
          btn.textContent = p;
          if (p === currentPage) btn.classList.add('active');
          btn.addEventListener('click', () => render(p));
          paginationNav.appendChild(btn);
        }
      }
    }
    render(1);
  }
</script>