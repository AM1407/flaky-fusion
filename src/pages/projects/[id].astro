---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/navbar.astro';
import Footer from '../../components/footer.astro';
import projectsData from '../../data/projects.json';

interface MultilangText {
  nl: string;
  en: string;
}

interface Project {
  id: string;
  title: MultilangText;
  description: MultilangText;
  fullDescription?: MultilangText;
  image?: string;
  stack?: string[];
  github?: string;
  featured?: boolean;
}

export async function getStaticPaths() {
  const typedProjects = projectsData as Project[];
  return typedProjects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { id } = Astro.params;
const project = Astro.props.project as Project;

// VERBETERDE TAALDETECTIE:
// Controleer eerst of de locale in de URL zit, anders fallback naar de standaard
const lang = (Astro.currentLocale || 'nl') as keyof MultilangText;

// Laad beide content versies in voor de client-side switch
let ContentNL, ContentEN;
try {
  const modNL = await import(`../../data/projecttext/${id}-nl.md`);
  ContentNL = modNL.Content;
} catch (e) { ContentNL = null; }

try {
  const modEN = await import(`../../data/projecttext/${id}-en.md`);
  ContentEN = modEN.Content;
} catch (e) { ContentEN = null; }

if (!project) return Astro.redirect('/404');
---

<Layout 
  title={`${project.title[lang]} | Projects`} 
  description={project.description[lang]}
>
  <Navbar />
  
  <main>
  <article class="project-detail">
    <header>
      <a href="/projects" class="back-link" data-i18n="projectDetail.backLink">&larr; Back to Overview</a>
      <h1 data-field="title">{project.title[lang]}</h1>
      
      <div class="tech-stack">
        {project.stack?.map((tech) => (
          <span class="badge">{tech}</span>
        ))}
      </div>

      {project.github && (
        <a href={project.github} target="_blank" rel="noopener noreferrer" class="github-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View on GitHub
        </a>
      )}
    </header>

    <div class="detail-content">
      <img src={project.image} alt={project.title[lang]} class="hero-img" width="1200" height="630" loading="lazy" />
      
      <div class="description-container">
        {/* Render BEIDE talen en laat CSS/JS bepalen welke zichtbaar is */}
        <div id="content-nl" style={lang === 'nl' ? "display: block" : "display: none"}>
           {ContentNL ? <ContentNL /> : <p>{project.fullDescription?.nl || project.description.nl}</p>}
        </div>
        <div id="content-en" style={lang === 'en' ? "display: block" : "display: none"}>
           {ContentEN ? <ContentEN /> : <p>{project.fullDescription?.en || project.description.en}</p>}
        </div>
      </div>
    </div>
  </article>
  </main>
  <Footer />
</Layout>

<script define:vars={{ project }}>
  function switchDetailLanguage(newLang) {
    // 1. Update de statische tekst (Titel)
    const titleEl = document.querySelector('[data-field="title"]');
    if (titleEl) titleEl.textContent = project.title[newLang];

    // 2. Switch de Markdown/FullDescription containers
    const nlContainer = document.getElementById('content-nl');
    const enContainer = document.getElementById('content-en');

    if (nlContainer && enContainer) {
      nlContainer.style.display = newLang === 'nl' ? 'block' : 'none';
      enContainer.style.display = newLang === 'en' ? 'block' : 'none';
    }
  }

  // Luister naar de Nano Store event uit je languageStore.ts
  window.addEventListener('locale-changed', (event) => {
    switchDetailLanguage(event.detail);
  });

  // Initialisatie bij laden
  const currentLang = localStorage.getItem('lang') || 'en';
  switchDetailLanguage(currentLang);
</script>

<style>
  .project-detail { 
    max-width: 900px; 
    margin: 15vh auto; 
    padding: 0 5%; 
    color: #fff;
  }

  .back-link {
    color: var(--cyber-blue, #60a5fa);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  h1 {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }

  .hero-img { 
    width: 100%; 
    border: 1px solid rgba(255,255,255,0.1); 
    margin: 2rem 0; 
    border-radius: 8px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .badge { 
    display: inline-block;
    border: 1px solid var(--cyber-blue, #60a5fa); 
    color: var(--cyber-blue, #60a5fa); 
    padding: 4px 12px; 
    margin: 5px 10px 5px 0; 
    font-size: 0.8rem; 
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .github-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--cyber-blue, #60a5fa);
    color: var(--cyber-blue, #60a5fa);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.5px;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }

  .github-btn:hover {
    background: var(--cyber-blue, #60a5fa);
    color: #000;
  }

  .github-btn svg {
    flex-shrink: 0;
  }

  .description {
    line-height: 1.8;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .markdown-body :global(h2) { color: #fff; margin: 2rem 0 1rem; font-size: 1.8rem; }
  .markdown-body :global(p) { margin-bottom: 1.5rem; }
  .markdown-body :global(ul) { margin-bottom: 1.5rem; padding-left: 1.5rem; }
  .markdown-body :global(li) { margin-bottom: 0.5rem; }

  @media (max-width: 768px) {
    .project-detail {
      margin: 10vh auto;
      padding: 0 6%;
    }

    h1 {
      font-size: clamp(1.8rem, 8vw, 2.4rem);
      margin-bottom: 1rem;
    }

    .badge {
      font-size: 0.7rem;
      padding: 3px 8px;
      margin: 3px 6px 3px 0;
    }

    .github-btn {
      font-size: 0.82rem;
      padding: 0.4rem 1rem;
    }
  }
</style>