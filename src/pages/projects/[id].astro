---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/navbar.astro';
import projectsData from '../../data/projects.json';

// Generate a static page for each project ID
export async function getStaticPaths() {
  return projectsData.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

// Retrieve the project matching the current URL
const { project } = Astro.props;

// Redirect to 404 if no matching project is found
if (!project) {
  return Astro.redirect('/404');
}
---

<Layout title={`${project.title} | Projects`}>
  <Navbar />
  
  <article class="project-detail">
    <header>
      <a href="/projects" class="back-link" data-i18n="projectDetail.backLink">&larr; Back to Overview</a>
      <h1>{project.title}</h1>
      
      <div class="tech-stack">
        {/* Render tech badges if stack data exists */}
        {project.stack && project.stack.map((tech) => (
          <span class="badge">{tech}</span>
        ))}
      </div>
    </header>

    <div class="detail-content">
      {/* Project hero image with fallback */}
      <img 
        src={project.image || "/img/placeholder.jpg"} 
        alt={project.title} 
        class="hero-img" 
      />
      
      <div class="description">
        {/* Show full description if available, otherwise the short one */}
        <p>{project.fullDescription || project.description}</p>
      </div>
    </div>
  </article>
</Layout>

<style>
  .project-detail { 
    max-width: 900px; 
    margin: 15vh auto; 
    padding: 0 5%; 
    color: #fff;
  }

  .back-link {
    color: var(--cyber-blue, #0088cc);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .hero-img { 
    width: 100%; 
    border: 1px solid rgba(255,255,255,0.1); 
    margin: 2rem 0; 
    border-radius: 4px;
  }

  .badge { 
    display: inline-block;
    border: 1px solid var(--cyber-blue, #0088cc); 
    color: var(--cyber-blue, #0088cc); 
    padding: 4px 12px; 
    margin: 5px 10px 5px 0; 
    font-size: 0.8rem; 
    text-transform: uppercase;
  }

  .description {
    line-height: 1.8;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.8);
  }
</style>