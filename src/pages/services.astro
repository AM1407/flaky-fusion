---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
import servicesData from '../data/services.json';

const { hero, services, process: processSteps, cta } = servicesData;
---

<Layout title="Services" description="Full stack development, DevSecOps consulting, security audits, and cloud infrastructure services by Alessio Miccichè.">
  <Navbar />
  <main class="container">
    <!-- Page header -->
    <header class="hero">
      <h1 class="hero-title" data-i18n="services.heroTitle">{hero.title}</h1>
      <p class="hero-subtitle" data-i18n="services.heroSubtitle">{hero.subtitle}</p>
    </header>

    <!-- Service offering cards -->
    <section class="services-section">
      <div class="services-grid">
        {services.map((service, i) => (
          <div class="service-card">
            <div class="service-icon">
              <i class={service.icon}></i>
            </div>
            <h2 class="service-title" data-i18n={`services.items.${i}.title`}>{service.title}</h2>
            <p class="service-desc" data-i18n={`services.items.${i}.description`}>{service.description}</p>
            <ul class="service-highlights">
              {service.highlights.map((h, hi) => (
                <li><i class="fa-solid fa-check"></i> <span data-i18n={`services.items.${i}.highlights.${hi}`}>{h}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Step-by-step workflow -->
    <section class="process-section">
      <h2 class="section-heading" data-i18n="services.processTitle">How I Work</h2>
      <p class="section-subheading" data-i18n="services.processSubtitle">A straightforward process designed around clarity and results.</p>
      <div class="process-timeline">
        {processSteps.map((step, i) => (
          <div class="process-step">
            <div class="step-number">{String(step.step).padStart(2, '0')}</div>
            <div class="step-content">
              <h3 data-i18n={`services.processSteps.${i}.title`}>{step.title}</h3>
              <p data-i18n={`services.processSteps.${i}.description`}>{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Call to action -->
    <section class="cta-section">
      <div class="cta-card">
        <h2 class="cta-title" data-i18n="services.ctaTitle">{cta.title}</h2>
        <p class="cta-text" data-i18n="services.ctaText">{cta.text}</p>
        <a href={cta.buttonLink} class="cta-btn">
          <span data-i18n="services.ctaButton">{cta.buttonText}</span> <span class="arrow">&rarr;</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Page layout */
  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* Hero banner */
  .hero {
    text-align: center;
    padding: 48px 0 56px;
  }

  .hero-title {
    font-family: var(--font-main);
    font-variation-settings: "wght" 800, "wdth" 110;
    color: #fff;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    color: var(--gordian-text);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Service cards grid */
  .services-section {
    margin-bottom: 72px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .service-card {
    padding: 32px 28px;
    border-radius: 16px;
    background: linear-gradient(145deg, #33373f, #282c33);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow:
      6px 6px 16px rgba(0, 0, 0, 0.4),
      -3px -3px 10px rgba(255, 255, 255, 0.02),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition:
      transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 136, 204, 0.3);
    box-shadow:
      0 14px 36px rgba(0, 136, 204, 0.12),
      0 6px 16px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .service-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    background: rgba(0, 136, 204, 0.1);
    border: 1px solid rgba(0, 136, 204, 0.2);
    box-shadow: 0 2px 10px rgba(0, 136, 204, 0.15);
  }

  .service-icon i {
    font-size: 1.3rem;
    color: var(--gordian-blue);
  }

  .service-title {
    color: #fff;
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .service-desc {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0 0 18px;
  }

  .service-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .service-highlights li {
    font-size: 0.78rem;
    padding: 5px 12px;
    border-radius: 20px;
    background: rgba(0, 136, 204, 0.08);
    border: 1px solid rgba(0, 136, 204, 0.15);
    color: rgba(255, 255, 255, 0.65);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .service-highlights li i {
    font-size: 0.6rem;
    color: var(--gordian-blue);
  }

  /* Shared section headings */
  .section-heading {
    font-family: var(--font-main);
    font-variation-settings: "wght" 800, "wdth" 110;
    color: #fff;
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    margin: 0 0 8px;
    text-align: center;
    letter-spacing: -0.02em;
  }

  .section-subheading {
    color: var(--gordian-text);
    font-size: 1rem;
    text-align: center;
    margin: 0 0 40px;
    line-height: 1.6;
  }

  /* Process timeline with connecting line */
  .process-section {
    margin-bottom: 72px;
  }

  .process-timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    position: relative;
  }

  /* Horizontal line connecting timeline steps */
  .process-timeline::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 12%;
    right: 12%;
    height: 2px;
    background: linear-gradient(90deg,
      rgba(0, 136, 204, 0.05),
      rgba(0, 136, 204, 0.25) 30%,
      rgba(0, 136, 204, 0.25) 70%,
      rgba(0, 136, 204, 0.05)
    );
    z-index: 0;
  }

  .process-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .step-number {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-main);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--gordian-blue);
    background: linear-gradient(145deg, #33373f, #282c33);
    border: 2px solid rgba(0, 136, 204, 0.3);
    box-shadow:
      0 4px 14px rgba(0, 0, 0, 0.35),
      0 2px 8px rgba(0, 136, 204, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    margin-bottom: 16px;
    flex-shrink: 0;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .process-step:hover .step-number {
    border-color: var(--gordian-blue);
    box-shadow:
      0 4px 20px rgba(0, 136, 204, 0.3),
      0 2px 8px rgba(0, 136, 204, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .step-content h3 {
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 6px;
  }

  .step-content p {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Call to action card */
  .cta-section {
    margin-bottom: 20px;
  }

  .cta-card {
    text-align: center;
    padding: 56px 40px;
    border-radius: 20px;
    background: linear-gradient(145deg, #33373f, #282c33);
    border: 1px solid rgba(0, 136, 204, 0.15);
    box-shadow:
      6px 6px 20px rgba(0, 0, 0, 0.4),
      -3px -3px 10px rgba(255, 255, 255, 0.02),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
  }

  /* Subtle glow effect behind the CTA card */
  .cta-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(0, 136, 204, 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .cta-title {
    font-family: var(--font-main);
    font-variation-settings: "wght" 800, "wdth" 110;
    color: #fff;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 0 0 12px;
    position: relative;
  }

  .cta-text {
    color: rgba(255, 255, 255, 0.55);
    font-size: 1.05rem;
    margin: 0 0 28px;
    position: relative;
  }

  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 36px;
    border-radius: 10px;
    font-family: var(--font-main);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: #fff;
    background: var(--gordian-blue);
    border: 1px solid var(--gordian-blue);
    box-shadow: 0 4px 20px rgba(0, 136, 204, 0.3);
    transition: all 0.3s ease;
    position: relative;
  }

  .cta-btn:hover {
    background: #009ee6;
    border-color: #009ee6;
    box-shadow: 0 6px 28px rgba(0, 136, 204, 0.45);
    transform: translateY(-2px);
  }

  .cta-btn .arrow {
    transition: transform 0.3s ease;
  }

  .cta-btn:hover .arrow {
    transform: translateX(4px);
  }

  /* Mobile layout adjustments */
  @media (max-width: 800px) {
    .services-grid {
      grid-template-columns: 1fr;
    }

    .process-timeline {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .process-timeline::before {
      display: none;
    }

    .process-step {
      flex-direction: row;
      text-align: left;
      gap: 16px;
    }

    .step-number {
      margin-bottom: 0;
    }

    .cta-card {
      padding: 40px 24px;
    }
  }
</style>
